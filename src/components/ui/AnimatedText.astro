---
type AnimatedTextTag = 'h1' | 'h2' | 'p' | 'span';

interface Props {
  text: string;
  as?: AnimatedTextTag;
  id?: string;
  className?: string;
  style?: string;
  delay?: number;
  stagger?: number;
}

const {
  text,
  as = 'span',
  id,
  className = '',
  style,
  delay = 420,
  stagger = 44
} = Astro.props;

const Tag = as;
const characters = Array.from(text);
---

<Tag id={id} class={`animated-text ${className}`} style={style} aria-label={text}>
  <span class="animated-text__content" aria-hidden="true">
    {characters.map((character, index) => {
      const isSpace = character === ' ';
      const isFinalPeriod = character === '.' && index === characters.length - 1;
      const charDelay = delay + index * stagger;

      return (
        <span
          class:list={[
            'animated-text__char',
            { 'animated-text__char--space': isSpace, 'animated-text__char--final-period': isFinalPeriod }
          ]}
          style={`--char-delay: ${charDelay}ms; --period-delay: ${charDelay + 240}ms;`}
        >
          {isSpace ? '\u00A0' : character}
        </span>
      );
    })}
  </span>
</Tag>

<style>
  .animated-text {
    display: block;
    color: var(--animated-text-color, inherit);
    font-size: var(--animated-text-size, inherit);
    font-weight: var(--animated-text-weight, inherit);
    line-height: var(--animated-text-line-height, inherit);
    overflow: visible;
  }

  .animated-text__content {
    display: inline-block;
    overflow: visible;
    white-space: nowrap;
  }

  .animated-text__char {
    display: inline-block;
    opacity: 0;
    filter: blur(2px);
    transform: translateY(0.16em);
    animation: animated-text-char-in 240ms cubic-bezier(0.16, 1, 0.3, 1) var(--char-delay) forwards;
    will-change: opacity, filter, transform;
  }

  .animated-text__char--space {
    width: 0.26em;
  }

  .animated-text__char--final-period {
    animation:
      animated-text-char-in 240ms cubic-bezier(0.16, 1, 0.3, 1) var(--char-delay) forwards,
      animated-text-period-blink 820ms steps(1, end) var(--period-delay) 20 forwards;
  }

  @keyframes animated-text-char-in {
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @keyframes animated-text-period-blink {
    0%,
    45% {
      opacity: 1;
    }

    46%,
    90% {
      opacity: 0;
    }

    91%,
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated-text__char,
    .animated-text__char--final-period {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>
