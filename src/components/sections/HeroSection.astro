---
import { DEFAULT_LANGUAGE, getTranslations } from '../../i18n';
import AnimatedText from '../ui/AnimatedText.astro';
import EmailCat from '../ui/EmailCat.astro';

const copy = getTranslations(DEFAULT_LANGUAGE);
---

<section id="inicio" class="hero-section" aria-labelledby="hero-title">
  <div class="container hero-container">
    <div class="hero-copy">
      <p class="availability">
        <span class="availability-dot"></span>
        <span data-i18n="hero.availability">{copy.hero.availability}</span>
      </p>

      <AnimatedText
        id="hero-title"
        as="h1"
        text={copy.hero.title}
        className="hero-title"
        delay={520}
        stagger={48}
      />
      <p class="hero-subtitle" data-i18n="hero.subtitle">{copy.hero.subtitle}</p>
    </div>

    <EmailCat email={copy.profile.email} className="hero-email" variant="compact" />
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 20%, rgba(var(--color-lilac), 0.055), transparent 24rem),
      radial-gradient(circle at 82% 70%, rgba(var(--color-lilac), 0.04), transparent 22rem);
  }

  .hero-section::before {
    content: none;
  }

  .hero-section::after {
    content: '';
    position: absolute;
    left: var(--space-6);
    right: var(--space-6);
    bottom: 0;
    height: 1px;
    background: var(--color-border);
    opacity: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: grid;
    align-items: center;
    padding-top: clamp(7rem, 12vh, 9rem);
    padding-bottom: clamp(5rem, 10vh, 8rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(1040px, 94vw);
    max-width: 1040px;
    color: var(--color-text-primary);
    overflow: visible;
    transform: translateY(-2vh);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 1.7rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 400;
    opacity: 0;
    transform: translateY(8px);
    animation: hero-soft-enter 520ms ease 120ms forwards;
  }

  .availability-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: #28d66f;
    box-shadow: 0 0 0 0 rgba(40, 214, 111, 0.42);
    animation: availability-pulse 1.8s ease-out infinite;
  }

  :global(.hero-title) {
    --animated-text-size: 8.9rem;
    --animated-text-line-height: 0.94;
    --animated-text-weight: 700;

    color: var(--color-text-primary);
    font-size: var(--animated-text-size);
    font-weight: 800;
    line-height: var(--animated-text-line-height);
    letter-spacing: 0;
    padding-block: 0.04em 0.1em;
    white-space: nowrap;
    opacity: 0;
    overflow: visible;
    cursor: default;
    animation: hero-fade-in 720ms ease 360ms forwards;
    transition:
      color var(--transition-normal),
      filter var(--transition-normal),
      transform var(--transition-normal);
  }

  :global(.hero-title .animated-text__char) {
    transition:
      color 420ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 420ms cubic-bezier(0.16, 1, 0.3, 1),
      text-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.hero-title:hover) {
    color: var(--color-lilac-text);
    filter: drop-shadow(0 16px 34px rgba(var(--color-lilac), 0.16));
    transform: translateY(-2px);
  }

  :global(.hero-title:hover .animated-text__char:nth-child(odd)) {
    color: var(--color-lilac-text);
    text-shadow: 0 0 24px rgba(var(--color-lilac), 0.24);
    transform: translateY(-0.045em);
  }

  :global(.hero-title:hover .animated-text__char:nth-child(even)) {
    color: color-mix(in srgb, var(--color-lilac-text) 74%, var(--color-text-primary));
    text-shadow: 0 0 18px rgba(var(--color-lilac), 0.16);
    transform: translateY(0.025em);
  }

  :global(.hero-title:hover .animated-text__char--final-period) {
    color: var(--color-lilac-text);
    transform: translateY(-0.08em) scale(1.12);
  }

  :global(html[data-theme='light'] .hero-title:hover) {
    color: var(--color-text-primary);
    filter: drop-shadow(0 10px 20px rgba(var(--color-lilac), 0.08));
    transform: translateY(-1px);
  }

  :global(html[data-theme='light'] .hero-title:hover .animated-text__char:nth-child(odd)) {
    color: color-mix(in srgb, var(--color-text-primary) 88%, var(--color-lilac-text));
    text-shadow: 0 0 12px rgba(var(--color-lilac), 0.08);
    transform: translateY(-0.018em);
  }

  :global(html[data-theme='light'] .hero-title:hover .animated-text__char:nth-child(even)) {
    color: color-mix(in srgb, var(--color-text-primary) 92%, var(--color-lilac-text));
    text-shadow: 0 0 10px rgba(var(--color-lilac), 0.06);
    transform: translateY(0.01em);
  }

  :global(html[data-theme='light'] .hero-title:hover .animated-text__char--final-period) {
    color: color-mix(in srgb, var(--color-text-primary) 84%, var(--color-lilac-text));
    transform: translateY(-0.025em) scale(1.04);
  }

  .hero-subtitle {
    margin-top: 1.25rem;
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(12px);
    animation: hero-soft-enter 900ms ease 2s forwards;
  }

  :global(.email-cat.hero-email) {
    position: absolute;
    right: var(--space-6);
    bottom: clamp(7rem, 15vh, 10rem);
    z-index: 3;
    opacity: 0;
    transform: translateY(8px);
    animation: hero-soft-enter 900ms ease 2.25s forwards;
  }

  @keyframes hero-soft-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes availability-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(40, 214, 111, 0.42);
      transform: scale(1);
    }

    70% {
      box-shadow: 0 0 0 10px rgba(40, 214, 111, 0);
      transform: scale(1.05);
    }

    100% {
      box-shadow: 0 0 0 0 rgba(40, 214, 111, 0);
      transform: scale(1);
    }
  }

  @media (max-width: 980px) {
    .hero-copy {
      width: min(720px, 88vw);
      transform: translateY(-4vh);
    }

    :global(.email-cat.hero-email) {
      right: var(--space-6);
      bottom: clamp(5.5rem, 13vh, 8rem);
    }

    :global(.hero-title) {
      --animated-text-size: 6.7rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }
  }

  @media (max-width: 760px) {
    .hero-section {
      min-height: 100svh;
    }

    .hero-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: clamp(2.75rem, 10vh, 5rem);
      padding-top: clamp(6.5rem, 16vh, 8rem);
      padding-bottom: clamp(3rem, 8vh, 5rem);
    }

    .hero-copy {
      width: 100%;
      max-width: none;
      transform: none;
    }

    .availability {
      margin-bottom: 1.2rem;
      font-size: 0.875rem;
    }

    :global(.hero-title) {
      --animated-text-size: 4.5rem;
      --animated-text-line-height: 1.08;
      white-space: normal;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    :global(.email-cat.hero-email) {
      position: relative;
      align-self: stretch;
      right: auto;
      bottom: auto;
      max-width: calc(100vw - var(--space-8));
    }

    :global(.email-cat.hero-email .email-cat__button) {
      width: 100%;
    }
  }

  @media (max-width: 460px) {
    :global(.hero-title) {
      --animated-text-size: 3.25rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability,
    .availability-dot,
    :global(.hero-title),
    :global(.hero-title:hover),
    :global(.hero-title .animated-text__char),
    :global(.hero-title:hover .animated-text__char),
    .hero-subtitle,
    :global(.email-cat.hero-email) {
      animation: none;
      opacity: 1;
      filter: none;
      text-shadow: none;
      transform: none;
    }
  }
</style>
