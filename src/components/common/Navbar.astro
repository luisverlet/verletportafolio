---
import { navLinks } from '../../data/navigation';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <nav class="nav-shell" aria-label="Principal" data-site-nav>
    <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>

    <ul class="nav-list">
      {navLinks.map((link, index) => (
        <li>
          <a href={link.url} class:list={['nav-link', { 'is-active': index === 0 }]} data-nav-link>
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-theme-toggle">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: clamp(1.5rem, 4.5vh, 2.4rem);
    left: 0;
    z-index: var(--z-sticky);
    width: 100%;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .nav-shell {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    pointer-events: auto;
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    background: var(--color-navbar);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px);
    padding: 3px;
    overflow: hidden;
  }

  .nav-list {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list li {
    position: relative;
    z-index: 1;
  }

  .nav-indicator {
    position: absolute;
    top: 3px;
    left: 0;
    z-index: 0;
    width: var(--nav-indicator-width, 0px);
    height: var(--nav-indicator-height, 30px);
    border-radius: var(--radius-full);
    background: #ffffff;
    opacity: var(--nav-indicator-opacity, 0);
    transform: translateX(var(--nav-indicator-x, 0px));
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      width 260ms cubic-bezier(0.16, 1, 0.3, 1),
      height 260ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 160ms ease;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 30px;
    padding: 0 16px;
    border-radius: var(--radius-full);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease,
      font-weight 180ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #ffffff;
    opacity: 0.72;
  }

  .nav-link.is-active {
    color: #000000;
    font-weight: 700;
    opacity: 1;
  }

  .nav-theme-toggle {
    display: none;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .site-header {
      top: 20px;
      padding: 0 var(--space-4);
    }

    .nav-shell {
      width: 100%;
      max-width: 460px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-shell::-webkit-scrollbar {
      display: none;
    }

    .nav-list {
      flex: 1 1 auto;
      justify-content: flex-start;
      gap: 2px;
      min-width: max-content;
    }

    .nav-theme-toggle {
      display: block;
      padding-left: 3px;
    }

    .nav-theme-toggle :global(.theme-toggle) {
      width: 38px;
      height: 30px;
      border-color: rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.08);
      box-shadow: none;
      color: #ffffff;
    }

    .nav-theme-toggle :global(.theme-toggle__track) {
      width: 27px;
      height: 16px;
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
    }

    .nav-theme-toggle :global(.theme-toggle__thumb) {
      top: 2px;
      left: 2px;
      background: #ffffff;
    }

    .nav-theme-toggle :global(.theme-toggle[data-theme-state='light'] .theme-toggle__thumb) {
      transform: translateX(11px);
    }

    .nav-link {
      padding: 0 7px;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 390px) {
    .nav-link {
      padding: 0 6px;
      font-size: 0.66rem;
    }
  }
</style>

<script>
  function initSiteNav() {
    const nav = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!nav) return;
    if (nav.dataset.navReady === 'true') return;
    nav.dataset.navReady = 'true';

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const indicator = nav.querySelector<HTMLElement>('[data-nav-indicator]');
    const controller = new AbortController();
    const sectionMap = new Map<string, HTMLElement>();
    let pauseScrollSpyUntil = 0;

    const moveIndicator = (activeLink: HTMLAnchorElement | undefined) => {
      if (!indicator || !activeLink) return;

      const navRect = nav.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();

      nav.style.setProperty('--nav-indicator-x', `${linkRect.left - navRect.left}px`);
      nav.style.setProperty('--nav-indicator-width', `${linkRect.width}px`);
      nav.style.setProperty('--nav-indicator-height', `${linkRect.height}px`);
      nav.style.setProperty('--nav-indicator-opacity', '1');
    };

    const setActiveLink = (targetHash: string) => {
      let activeLink: HTMLAnchorElement | undefined;

      links.forEach((link) => {
        const isActive = link.hash === targetHash;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }

        if (isActive) {
          activeLink = link;
        }
      });

      moveIndicator(activeLink);
    };

    links.forEach((link) => {
      const targetId = decodeURIComponent(link.hash.replace('#', ''));
      const section = document.getElementById(targetId);

      if (section) {
        sectionMap.set(link.hash, section);
      }

      link.addEventListener(
        'click',
        () => {
          pauseScrollSpyUntil = Date.now() + 850;
          setActiveLink(link.hash);
        },
        { signal: controller.signal }
      );
    });

    const currentHash = window.location.hash || links[0]?.hash;
    if (currentHash) {
      setActiveLink(currentHash);
    }

    window.addEventListener(
      'resize',
      () => {
        const activeLink = links.find((link) => link.classList.contains('is-active'));
        moveIndicator(activeLink);
      },
      { signal: controller.signal }
    );

    if (!('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        if (Date.now() < pauseScrollSpyUntil) return;

        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];

        if (visibleEntry?.target.id) {
          setActiveLink(`#${visibleEntry.target.id}`);
        }
      },
      {
        rootMargin: '-35% 0px -45% 0px',
        threshold: [0.08, 0.2, 0.4, 0.6]
      }
    );

    sectionMap.forEach((section) => observer.observe(section));

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        controller.abort();
      },
      { once: true }
    );
  }

  initSiteNav();

  document.addEventListener('astro:page-load', initSiteNav);
</script>
