---
import { projects } from '../../data/projects';
import SectionTitle from '../common/SectionTitle.astro';
import ProjectCard from '../ui/ProjectCard.astro';

const featuredProjects = projects.filter((project) => project.featured);
---

<section id="proyectos" class="projects-section">
  <div class="container projects-container">
    <SectionTitle
      title="Proyectos Destacados"
      subtitle="Trabajos"
      align="center"
    />

    <div class="projects-grid">
      {featuredProjects.map((project) => (
        <div class="project-item">
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    overflow: hidden;
    padding: var(--space-20) 0;
    border-top: 1px solid var(--border-color);
    background: var(--color-ink);
  }

  .projects-section::before {
    content: '';
    position: absolute;
    inset: -14vh -10vw;
    z-index: 0;
    pointer-events: none;
    background:
      repeating-radial-gradient(ellipse at 50% 12%, transparent 0 54px, rgba(255, 255, 255, 0.026) 56px 59px, transparent 61px 110px),
      repeating-radial-gradient(ellipse at 60% 92%, transparent 0 62px, rgba(255, 255, 255, 0.018) 64px 67px, transparent 69px 122px);
    transform: rotate(-7deg);
  }

  .projects-section::after {
    content: '';
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: min(18vw, 220px);
    height: min(10vw, 120px);
    background: var(--color-hero-band);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .projects-container {
    position: relative;
    z-index: 1;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 7vw, 5rem);
    align-items: start;
    max-width: 940px;
    margin-top: var(--space-12);
    margin-inline: auto;
  }

  .project-item {
    min-width: 0;
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
  }

</style>
