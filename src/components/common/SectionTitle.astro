---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  titleKey?: string;
  subtitleKey?: string;
}

const { title, subtitle, align = 'left', titleKey, subtitleKey } = Astro.props;
---

<div class={`section-title-wrapper ${align}`}>
  {subtitle && <span class="subtitle reveal" style="--delay: 0ms" data-i18n={subtitleKey}>{subtitle}</span>}
  <h2 class="title reveal" style="--delay: 80ms" data-i18n={titleKey}>{title}</h2>
  <span class="title-underline reveal" style="--delay: 140ms"></span>
</div>

<style>
  .section-title-wrapper {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-10);
  }

  .section-title-wrapper.left {
    align-items: flex-start;
    text-align: left;
  }

  .section-title-wrapper.center {
    align-items: center;
    text-align: center;
  }

  .subtitle {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0;
    font-weight: 800;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    position: relative;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 3rem;
    }
  }

  .title-underline {
    display: none;
    width: 60px;
    height: 4px;
    background: var(--accent-gradient);
    border-radius: var(--radius-full);
    margin-top: var(--space-4);
  }
</style>
