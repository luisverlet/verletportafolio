---
import { siteConfig } from '../../data/site';
import AnimatedText from '../ui/AnimatedText.astro';
import EmailCat from '../ui/EmailCat.astro';
---

<section id="inicio" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-band" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-copy">
      <p class="availability">
        <span class="availability-dot"></span>
        Disponible para nuevos proyectos
      </p>

      <AnimatedText
        id="hero-title"
        as="h1"
        text={`${siteConfig.name}.`}
        className="hero-title"
        delay={520}
        stagger={48}
      />
      <p class="hero-subtitle">Portafolio de proyectos</p>
    </div>

    <EmailCat email={siteConfig.email} className="hero-email" />
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: -16vh -12vw;
    z-index: 0;
    pointer-events: none;
    background:
      repeating-radial-gradient(ellipse at 84% 68%, transparent 0 58px, rgba(255, 255, 255, 0.022) 60px 62px, transparent 64px 112px),
      repeating-radial-gradient(ellipse at 8% 102%, transparent 0 52px, rgba(255, 255, 255, 0.018) 54px 57px, transparent 59px 108px);
    transform: rotate(-7deg);
  }

  .hero-band {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--color-hero-band);
    clip-path: polygon(0 0, 100% 42%, 100% 72%, 0 45%);
    animation: hero-band-enter 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: grid;
    align-items: center;
    padding-top: clamp(7rem, 12vh, 9rem);
    padding-bottom: clamp(5rem, 10vh, 8rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(820px, 88vw);
    max-width: 820px;
    color: var(--color-white);
    overflow: visible;
    transform: translateY(-3vh);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(1.25rem, 2.8vw, 2.5rem);
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(0.82rem, 0.95vw, 0.95rem);
    font-weight: 400;
    opacity: 0;
    transform: translateY(8px);
    animation: hero-soft-enter 520ms ease 120ms forwards;
  }

  .availability-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: var(--color-white);
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.12);
  }

  :global(.hero-title) {
    --animated-text-size: clamp(4rem, 7vw, 7.5rem);
    --animated-text-line-height: 1.06;
    --animated-text-weight: 700;

    color: var(--color-white);
    font-size: var(--animated-text-size);
    font-weight: 700;
    line-height: var(--animated-text-line-height);
    letter-spacing: -0.04em;
    padding-block: 0.04em 0.08em;
    white-space: nowrap;
    opacity: 0;
    overflow: visible;
    animation: hero-fade-in 720ms ease 360ms forwards;
  }

  .hero-subtitle {
    margin-top: clamp(0.55rem, 1vw, 1rem);
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.6rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(12px);
    animation: hero-soft-enter 900ms ease 2s forwards;
  }

  :global(.email-cat.hero-email) {
    position: absolute;
    right: var(--space-6);
    bottom: clamp(7rem, 17vh, 12rem);
    z-index: 3;
    opacity: 0;
    transform: translateY(8px);
    animation: hero-soft-enter 900ms ease 2.25s forwards;
  }

  @keyframes hero-soft-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes hero-band-enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 980px) {
    .hero-copy {
      width: min(720px, 88vw);
      transform: translateY(-4vh);
    }

    :global(.email-cat.hero-email) {
      right: var(--space-6);
      bottom: clamp(5.5rem, 13vh, 8rem);
    }
  }

  @media (max-width: 760px) {
    .hero-section {
      min-height: 100svh;
    }

    .hero-band {
      clip-path: polygon(0 12%, 100% 34%, 100% 70%, 0 53%);
      animation-name: hero-band-enter-mobile;
    }

    .hero-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: clamp(2.75rem, 10vh, 5rem);
      padding-top: clamp(6.5rem, 16vh, 8rem);
      padding-bottom: clamp(3rem, 8vh, 5rem);
    }

    .hero-copy {
      width: 100%;
      max-width: none;
      transform: none;
    }

    .availability {
      margin-bottom: clamp(1rem, 4vw, 1.6rem);
      font-size: 0.875rem;
    }

    :global(.hero-title) {
      --animated-text-size: clamp(3.2rem, 15vw, 5rem);
      --animated-text-line-height: 1.08;
    }

    .hero-subtitle {
      font-size: clamp(1.25rem, 6vw, 2rem);
    }

    :global(.email-cat.hero-email) {
      position: relative;
      align-self: flex-end;
      right: auto;
      bottom: auto;
      max-width: calc(100vw - var(--space-8));
    }
  }

  @keyframes hero-band-enter-mobile {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-band,
    .availability,
    :global(.hero-title),
    .hero-subtitle,
    :global(.email-cat.hero-email) {
      animation: none;
      opacity: 1;
      transform: none;
    }

  }
</style>
