---

<div class="pt-bg" data-personal-tech-bg>
  <div class="pt-bg__aurora"></div>
  <div class="pt-bg__grid"></div>
  <svg class="pt-bg__lines" viewBox="0 0 1200 800" preserveAspectRatio="none" aria-hidden="true">
    <path d="M55 190C220 120 330 168 486 132S742 42 905 92s207 163 262 123" />
    <path d="M112 606c128-80 265-56 398-19s237 8 353-69 214-71 293-21" />
    <path d="M226 365c132-44 244-19 332 34s189 62 316-12 194-69 264-35" />
  </svg>

  <div class="pt-bg__icons">
    {
      items.map((item, index) => {
        const scrollShift = ((index % 7) - 3) * 7;
        const iconStyles = `--x: ${item.x}; --y: ${item.y}; --size: ${item.size}; --duration: ${item.duration}; --delay: ${item.delay}; --drift: ${item.drift}; --rotate: ${item.rotate}; --icon-url: url("${iconUrl(item.icon)}");`;

        return item.egg ? (
          <button
            class="pt-bg__item pt-bg__egg"
            type="button"
            data-depth={item.depth}
            data-tone={item.tone}
            data-kind={item.kind}
            data-mobile={item.mobile}
            data-easter-egg
            data-scroll-shift={scrollShift}
            style={iconStyles}
            tabindex="-1"
            aria-hidden="true"
          >
            {item.kind === 'brand' ? (
              <img class="pt-bg__logo" src={iconUrl(item.icon)} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="pt-bg__symbol"></span>
            )}
          </button>
        ) : (
          <span
            class="pt-bg__item"
            data-depth={item.depth}
            data-tone={item.tone}
            data-kind={item.kind}
            data-mobile={item.mobile}
            data-scroll-shift={scrollShift}
            style={iconStyles}
            aria-hidden="true"
          >
            {item.kind === 'brand' ? (
              <img class="pt-bg__logo" src={iconUrl(item.icon)} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="pt-bg__symbol"></span>
            )}
          </span>
        );
      })
    }
  </div>

  <div class="pt-bg__egg-message" data-easter-egg-message>me estoy mareando..</div>
</div>

<button
  class="pt-bg-egg-trigger"
  type="button"
  data-easter-egg-trigger
  aria-label="Activar voltereta del gato"
>
  <span></span>
</button>

<div class="pt-bg-egg-toast" data-easter-egg-toast>me estoy mareando..</div>

<script>
  const initPersonalTechBackground = () => {
    const background = document.querySelector<HTMLElement>('[data-personal-tech-bg]');
    if (!background || background.dataset.ready === 'true') return;

    background.dataset.ready = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const egg = background.querySelector<HTMLButtonElement>('[data-easter-egg]');
    const message = background.querySelector<HTMLElement>('[data-easter-egg-message]');
    const eggTrigger = document.querySelector<HTMLButtonElement>('[data-easter-egg-trigger]');
    const eggToast = document.querySelector<HTMLElement>('[data-easter-egg-toast]');
    const parallaxItems = Array.from(background.querySelectorAll<HTMLElement>('[data-scroll-shift]'));
    let ticking = false;
    let messageTimeout = 0;
    let eggClickCount = 0;

    const updateScrollState = () => {
      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      const progress = Math.min(window.scrollY / maxScroll, 1);

      background.style.setProperty('--scroll-aura-x', `${progress * 18}%`);
      background.style.setProperty('--scroll-aura-y', `${progress * -20}%`);
      background.style.setProperty('--scroll-grid-x', `${progress * 72}px`);
      background.style.setProperty('--scroll-grid-y', `${progress * -80}px`);
      background.style.setProperty('--scroll-grid-diagonal-x', `${progress * -40}px`);
      background.style.setProperty('--scroll-grid-diagonal-y', `${progress * 46}px`);
      background.style.setProperty('--scroll-lines-y', `${progress * -22}px`);

      parallaxItems.forEach((item) => {
        const shift = Number(item.dataset.scrollShift || 0);
        item.style.setProperty('--scroll-offset', `${progress * shift}px`);
      });

      ticking = false;
    };

    const requestScrollState = () => {
      if (reducedMotion.matches || ticking) return;

      ticking = true;
      window.requestAnimationFrame(updateScrollState);
    };

    const triggerEgg = () => {
      if (!egg) return;

      egg.classList.remove('is-flipping');
      eggTrigger?.classList.remove('is-flipping');
      void egg.offsetWidth;
      if (eggTrigger) void eggTrigger.offsetWidth;
      egg.classList.add('is-flipping');
      eggTrigger?.classList.add('is-flipping');
      background.classList.add('is-egg-active');
      eggClickCount += 1;

      if (eggClickCount > 10) {
        message?.classList.add('is-visible');
        eggToast?.classList.add('is-visible');
      }

      window.clearTimeout(messageTimeout);
      messageTimeout = window.setTimeout(() => {
        egg.classList.remove('is-flipping');
        eggTrigger?.classList.remove('is-flipping');
        background.classList.remove('is-egg-active');
        if (eggClickCount > 10) {
          message?.classList.remove('is-visible');
          eggToast?.classList.remove('is-visible');
        }
      }, 2600);
    };

    egg?.addEventListener('click', triggerEgg);
    eggTrigger?.addEventListener('click', triggerEgg);

    updateScrollState();

    if (!reducedMotion.matches) {
      window.addEventListener('scroll', requestScrollState, { passive: true });
      window.addEventListener('resize', requestScrollState, { passive: true });
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', requestScrollState);
        window.removeEventListener('resize', requestScrollState);
        window.clearTimeout(messageTimeout);
        egg?.classList.remove('is-flipping');
        eggTrigger?.classList.remove('is-flipping');
        eggToast?.classList.remove('is-visible');
      },
      { once: true }
    );
  };

  initPersonalTechBackground();
  document.addEventListener('astro:page-load', initPersonalTechBackground);
</script>

<style>
  .pt-bg {
    --scroll-aura-x: 0%;
    --scroll-aura-y: 0%;
    --scroll-grid-x: 0px;
    --scroll-grid-y: 0px;
    --scroll-grid-diagonal-x: 0px;
    --scroll-grid-diagonal-y: 0px;
    --scroll-lines-y: 0px;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(3, 3, 8, 0.97) 0%, rgba(1, 2, 6, 0.94) 48%, rgba(0, 0, 0, 0.98) 100%),
      var(--color-bg);
    contain: layout paint style;
  }

  .pt-bg__aurora,
  .pt-bg__grid,
  .pt-bg__lines,
  .pt-bg__icons {
    position: absolute;
    inset: 0;
  }

  .pt-bg__aurora {
    background:
      radial-gradient(ellipse 72vw 42vh at calc(16% + var(--scroll-aura-x)) 12%, rgba(118, 76, 255, 0.09), transparent 64%),
      radial-gradient(ellipse 58vw 38vh at calc(88% - var(--scroll-aura-x)) 22%, rgba(41, 121, 255, 0.055), transparent 66%),
      radial-gradient(ellipse 64vw 42vh at 58% calc(92% + var(--scroll-aura-y)), rgba(154, 108, 255, 0.045), transparent 70%);
    filter: blur(20px) saturate(0.96);
    opacity: 0.46;
    animation: pt-bg-aurora 32s ease-in-out infinite alternate;
  }

  .pt-bg__grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.016) 1px, transparent 1px),
      linear-gradient(120deg, rgba(var(--color-lilac), 0.014) 1px, transparent 1px);
    background-position:
      0 var(--scroll-grid-y),
      var(--scroll-grid-x) 0,
      var(--scroll-grid-diagonal-x) var(--scroll-grid-diagonal-y);
    background-size: 72px 72px, 72px 72px, 180px 180px;
    mask-image:
      radial-gradient(circle at 50% 42%, #000 0 48%, transparent 78%),
      linear-gradient(#000, transparent 96%);
    opacity: 0.28;
  }

  .pt-bg__lines {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(198, 180, 255, 0.055);
    stroke-width: 1;
    stroke-dasharray: 4 16;
    opacity: 0.22;
    filter: blur(0.2px);
    transform: translateY(var(--scroll-lines-y));
    animation: pt-bg-lines 58s linear infinite;
  }

  .pt-bg__item {
    --item-opacity: 0.18;
    --item-blur: 0px;
    --item-scale: 1;

    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    width: var(--size);
    height: var(--size);
    place-items: center;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.018);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.16);
    color: rgb(218, 224, 235);
    opacity: var(--item-opacity);
    filter: blur(var(--item-blur));
    transform: translate3d(-50%, -50%, 0) rotate(var(--rotate)) scale(var(--item-scale));
    animation: pt-bg-float var(--duration) ease-in-out var(--delay) infinite alternate;
    will-change: transform;
  }

  button.pt-bg__item {
    appearance: none;
    padding: 0;
    pointer-events: auto;
    cursor: default;
  }

  .pt-bg__item[data-kind='pixel'] {
    image-rendering: pixelated;
    border-radius: 4px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
  }

  .pt-bg__item[data-kind='brand'] {
    background: rgba(255, 255, 255, 0.014);
  }

  .pt-bg__item[data-kind='brand']::before {
    content: '';
    display: block;
    width: 70%;
    height: 70%;
    background: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }

  .pt-bg__symbol {
    display: block;
    width: 63%;
    height: 63%;
    background: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }

  .pt-bg__logo {
    display: none;
    width: 70%;
    height: 70%;
    object-fit: contain;
    opacity: 0.86;
    filter: saturate(0.92) contrast(0.96);
  }

  .pt-bg__item[data-kind='brand'] {
    border-color: rgba(255, 255, 255, 0.09);
  }

  .pt-bg__item[data-tone='violet'] {
    color: rgb(205, 183, 255);
  }

  .pt-bg__item[data-tone='blue'] {
    color: rgb(149, 193, 255);
  }

  .pt-bg__item[data-tone='mint'] {
    color: rgb(160, 231, 207);
  }

  .pt-bg__item[data-tone='steel'] {
    color: rgb(218, 224, 235);
  }

  .pt-bg__item[data-tone='rose'] {
    color: rgb(255, 196, 214);
  }

  .pt-bg__item[data-depth='near'] {
    --item-opacity: 0.16;
    --item-scale: 1.04;
  }

  .pt-bg__item[data-depth='mid'] {
    --item-opacity: 0.115;
  }

  .pt-bg__item[data-depth='far'] {
    --item-opacity: 0.075;
    --item-blur: 0.45px;
    --item-scale: 0.98;
    animation: none;
    will-change: auto;
  }

  .pt-bg__egg::after {
    content: '';
    position: absolute;
    inset: -8px;
    border: 1px solid rgba(205, 183, 255, 0.14);
    border-radius: inherit;
    opacity: 0.18;
    transform: scale(1);
    transition: opacity 260ms ease, transform 260ms ease;
  }

  .pt-bg__egg {
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden;
  }

  .pt-bg__egg-message {
    display: none;
  }

  .pt-bg__egg-message.is-visible {
    opacity: 0.58;
    transform: translate3d(-50%, 0, 0);
  }

  .pt-bg.is-egg-active .pt-bg__egg::after {
    opacity: 0.68;
    transform: scale(1.2);
  }

  .pt-bg__egg.is-flipping {
    z-index: 2;
    animation: pt-bg-egg-flip 980ms cubic-bezier(0.2, 0.9, 0.2, 1.18) both;
  }

  .pt-bg-egg-trigger {
    --egg-trigger-size: 44px;
    --icon-url: url("https://api.iconify.design/ph:cat-duotone.svg");

    position: fixed;
    left: 18%;
    top: 64%;
    z-index: 0;
    display: grid;
    width: var(--egg-trigger-size);
    height: var(--egg-trigger-size);
    place-items: center;
    border: 1px solid rgba(205, 183, 255, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.012);
    color: rgb(205, 183, 255);
    cursor: pointer;
    opacity: 0.13;
    padding: 0;
    pointer-events: none;
    transform: translate3d(-50%, -50%, 0) rotate(-8deg);
    transition:
      border-color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease;
  }

  .pt-bg-egg-trigger span {
    display: block;
    width: 63%;
    height: 63%;
    background: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }

  .pt-bg-egg-trigger:hover,
  .pt-bg-egg-trigger:focus-visible {
    border-color: rgba(205, 183, 255, 0.22);
    opacity: 0.28;
