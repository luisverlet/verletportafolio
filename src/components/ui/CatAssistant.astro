---
import { DEFAULT_LANGUAGE, getTranslations } from '../../i18n';

const copy = getTranslations(DEFAULT_LANGUAGE).assistant;
---

<aside class="cat-assistant" data-cat-assistant data-state="sleeping" aria-label={copy.ariaLabel} data-i18n-aria-label="assistant.ariaLabel">
  <div class="cat-assistant__bubble" data-cat-bubble aria-live="polite">
    <span data-cat-message data-i18n="assistant.messages.0.message">{copy.messages[0].message}</span>
  </div>

  <button class="cat-assistant__close" type="button" data-cat-close aria-label={copy.closeLabel} data-i18n-aria-label="assistant.closeLabel">
    <span aria-hidden="true">&times;</span>
  </button>

  <div class="cat-assistant__pet" data-cat-pet aria-hidden="true">
    <div class="cat-assistant__stage">
      <svg class="cat-assistant__svg" viewBox="0 0 260 165" role="img" aria-label={copy.petAlt} data-i18n-aria-label="assistant.petAlt">
        <defs>
          <linearGradient id="catAssistantBodyGradient" x1="38" y1="48" x2="220" y2="145" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#34363a" />
            <stop offset="1" stop-color="#181a1d" />
          </linearGradient>
          <linearGradient id="catAssistantHeadGradient" x1="114" y1="28" x2="192" y2="116" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#3b3d41" />
            <stop offset="1" stop-color="#202226" />
          </linearGradient>
        </defs>

        <g class="cat-assistant__sleep">
          <text class="cat-assistant__sleep-mark cat-assistant__sleep-mark--small" x="99" y="25">z</text>
          <text class="cat-assistant__sleep-mark cat-assistant__sleep-mark--large" x="118" y="17">Z</text>
        </g>

        <g class="cat-assistant__cat">
          <path
            class="cat-assistant__body-shape"
            d="M31.2 116.6c0-29.3 23.7-53.1 57.7-53.1 22 0 36.9 9.1 47.8 23.2 7.1 9.2 15.4 19.6 33 19.6h21.8c14.6 0 26.5 10.9 26.5 24.3 0 12.2-8.3 21.6-21.7 21.6H58.4c-17.1 0-27.2-15.2-27.2-35.6Z"
          />

          <path
            class="cat-assistant__belly-line"
            d="M61.4 126.4c14.8-9.4 36-8.6 47.7 2.9"
          />

          <path
            class="cat-assistant__tail"
            d="M202.9 125.2c24.5-1.3 39.7-17.5 34.3-36.8-2.3-8.1-11.7-7.6-12.7.7-.7 6 3.8 11.5 10 11.7"
          />

          <g class="cat-assistant__head">
            <path
              class="cat-assistant__head-shape"
              d="M120.4 106.4c-11.8-9-15.4-27.8-10.5-51.2 1.8-8.5 4.7-22.2 9.2-23 4.8-.8 17 17.3 22.9 24.7 6.5-2.1 13.6-3.1 21-3.1 7.2 0 14 1 20.3 3 5.8-7.5 18.2-25.7 23-24.6 4.5 1 7.3 14.8 8.9 23.4 4.4 23.3.6 42-11.2 50.8-9.5 7.1-22 10.5-41.8 10.5-19.6 0-32.3-3.4-41.8-10.5Z"
            />
            <path class="cat-assistant__inner-ear cat-assistant__inner-ear--left" d="M121.2 48.3 134.6 68l-20.7 8.7c.4-11.7 2.8-22 7.3-28.4Z" />
            <path class="cat-assistant__inner-ear cat-assistant__inner-ear--right" d="M205 48.3 191.6 68l20.7 8.7c-.4-11.7-2.8-22-7.3-28.4Z" />

            <g class="cat-assistant__eyes-sleep">
              <path d="M142.2 82.6c3.5 4.2 8.8 4.2 12.3 0" />
              <path d="M171.4 82.6c3.5 4.2 8.8 4.2 12.3 0" />
            </g>

            <g class="cat-assistant__eyes-awake">
              <ellipse cx="148.8" cy="83.8" rx="8.2" ry="9.8" />
              <ellipse cx="178" cy="83.8" rx="8.2" ry="9.8" />
              <circle cx="150.9" cy="81" r="2.7" />
              <circle cx="180.1" cy="81" r="2.7" />
            </g>

            <path
              class="cat-assistant__face-detail cat-assistant__brows"
              d="M143.3 72.3c3.1-2.4 6.3-2.4 9.4 0M172.4 72.3c3.1-2.4 6.3-2.4 9.4 0"
            />
            <path class="cat-assistant__nose" d="M158.4 91.7c2.6-4.1 7.4-4.1 10 0-2.2 4.1-7.8 4.1-10 0Z" />
            <path class="cat-assistant__mouth" d="M163.4 96.8c-2.6 6.2-10 6.5-13.6 1.7M163.4 96.8c2.6 6.2 10 6.5 13.6 1.7" />
            <path class="cat-assistant__whiskers" d="M128.8 94h20.5M128.9 104.2l20.4-4.1M197.9 94h-20.5M197.8 104.2l-20.4-4.1" />
          </g>

          <g class="cat-assistant__paws">
            <path d="M117.2 144.8c-.9-11.1 5.1-16.5 14-16.5 8.7 0 13.8 5.5 13.2 16.5" />
            <path d="M158.2 144.8c-.9-11.1 5.1-16.5 14-16.5 8.7 0 13.8 5.5 13.2 16.5" />
            <path class="cat-assistant__paw-lines" d="M127.8 139.6v5.2M136.7 139.6v5.2M168.8 139.6v5.2M177.7 139.6v5.2" />
          </g>
        </g>
      </svg>
    </div>
  </div>
</aside>

<style>
  .cat-assistant {
    --cat-size: clamp(5.7rem, 9vw, 7.9rem);
    --cat-source-left: auto;
    --cat-source-top: auto;
    --cat-source-width: 58px;
    --cat-start-scale-x: 0.55;
    --cat-start-scale-y: 0.55;

    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: calc(var(--z-sticky) - 10);
    display: grid;
    grid-template-columns: minmax(0, 18rem) var(--cat-size);
    align-items: end;
    gap: 0.85rem;
    max-width: min(92vw, 28rem);
    pointer-events: none;
    opacity: 0;
    transform: translate(0, 0);
    transition:
      opacity 420ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 820ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cat-assistant.is-sourced {
    left: var(--cat-source-left);
    top: var(--cat-source-top);
    right: auto;
    bottom: auto;
    display: block;
    width: var(--cat-source-width);
    max-width: none;
  }

  .cat-assistant.is-ready {
    opacity: 1;
  }

  .cat-assistant.is-docked,
  .cat-assistant.is-measuring-docked {
    left: auto;
    top: auto;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    display: grid;
    width: auto;
    max-width: min(92vw, 28rem);
    transform: translate(0, 0) scale(1);
  }

  .cat-assistant.is-measuring-docked {
    opacity: 0;
    transition: none;
  }

  .cat-assistant.is-hidden {
    display: none;
  }

  :global(html.has-cat-assistant-source .email-cat.hero-email .email-cat__stage) {
    opacity: 0;
  }

  .cat-assistant__bubble {
    position: relative;
    align-self: center;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background:
      linear-gradient(145deg, rgba(var(--color-accent-primary-rgb), 0.04), transparent 52%),
      color-mix(in srgb, var(--color-card) 92%, transparent);
    box-shadow: var(--shadow-soft);
    color: var(--text-primary);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.35;
    padding: 0.85rem 1rem;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    backdrop-filter: blur(18px);
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal),
      border-color var(--transition-normal);
  }

  .cat-assistant.is-sourced .cat-assistant__bubble,
  .cat-assistant.is-sourced .cat-assistant__close {
    display: none;
  }

  .cat-assistant.is-docked .cat-assistant__bubble,
  .cat-assistant[data-state='talking'] .cat-assistant__bubble,
  .cat-assistant[data-state='happy'] .cat-assistant__bubble {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .cat-assistant__bubble::after {
    content: '';
    position: absolute;
    right: -7px;
    bottom: 28px;
    width: 13px;
    height: 13px;
    border-top: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card) 94%, transparent);
    transform: rotate(45deg);
  }

  .cat-assistant__close {
    position: absolute;
    right: calc(var(--cat-size) - 0.35rem);
    top: -0.45rem;
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-card);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
    opacity: 0;
    pointer-events: auto;
    transform: translateY(4px);
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .cat-assistant.is-docked .cat-assistant__close,
  .cat-assistant:hover .cat-assistant__close,
  .cat-assistant:focus-within .cat-assistant__close {
    opacity: 1;
    transform: translateY(0);
  }

  .cat-assistant__close:hover,
  .cat-assistant__close:focus-visible {
    border-color: var(--color-border-hover);
    color: var(--text-primary);
  }

  .cat-assistant__pet {
    position: relative;
    width: var(--cat-size);
    aspect-ratio: 260 / 165;
    pointer-events: auto;
    transform: scale(var(--cat-start-scale-x), var(--cat-start-scale-y));
    transform-origin: 0 0;
    transition: transform 820ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cat-assistant.is-sourced .cat-assistant__pet {
    width: 100%;
  }

  .cat-assistant:not(.is-ready) .cat-assistant__pet {
    pointer-events: none;
  }

  .cat-assistant.is-docked .cat-assistant__pet,
  .cat-assistant.is-measuring-docked .cat-assistant__pet {
    transform: scale(1);
  }

  .cat-assistant__stage {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.22));
    transform-origin: 72% 100%;
    animation: cat-assistant-breathe 4.8s ease-in-out infinite;
  }

  .cat-assistant__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cat-assistant__cat {
    animation: cat-assistant-body-breathe 4.8s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 54% 82%;
  }

  .cat-assistant__body-shape,
  .cat-assistant__head-shape {
    fill: url(#catAssistantBodyGradient);
  }

  .cat-assistant__head-shape {
    fill: url(#catAssistantHeadGradient);
  }

  .cat-assistant__tail {
    fill: none;
    stroke: #222428;
    stroke-width: 18;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: cat-assistant-tail-idle 4.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 6% 94%;
  }

  .cat-assistant__belly-line,
  .cat-assistant__mouth,
  .cat-assistant__whiskers,
  .cat-assistant__eyes-sleep path,
  .cat-assistant__brows,
  .cat-assistant__paws path {
    fill: none;
    stroke: rgba(222, 226, 232, 0.58);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cat-assistant__belly-line {
    stroke-width: 4;
    opacity: 0.35;
  }

  .cat-assistant__inner-ear {
    fill: rgba(10, 11, 14, 0.36);
  }

  .cat-assistant__head {
    transform-box: fill-box;
    transform-origin: 50% 76%;
    transition: transform 220ms ease;
  }

  .cat-assistant__eyes-sleep {
    opacity: 1;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .cat-assistant__eyes-sleep path {
    stroke-width: 4;
  }

  .cat-assistant__eyes-awake {
    opacity: 0;
    transform: scaleY(0.3);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .cat-assistant__eyes-awake ellipse {
    fill: #f5f6f8;
    stroke: rgba(255, 255, 255, 0.72);
    stroke-width: 2;
  }

  .cat-assistant__eyes-awake circle {
    fill: #111216;
  }

  .cat-assistant__brows {
    stroke-width: 3;
    opacity: 0.28;
  }

  .cat-assistant__nose {
    fill: #d9dde5;
  }

  .cat-assistant__mouth {
    stroke-width: 3.6;
  }

  .cat-assistant__whiskers {
    stroke-width: 3;
    opacity: 0.72;
  }

  .cat-assistant__paws path {
    stroke-width: 10;
    opacity: 0.56;
  }

  .cat-assistant__paws .cat-assistant__paw-lines {
    stroke-width: 2.2;
    opacity: 0.36;
  }

  .cat-assistant__sleep {
    opacity: 1;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .cat-assistant__sleep-mark {
    fill: rgba(30, 32, 35, 0.82);
    font-weight: 700;
    line-height: 1;
    transform-origin: center;
    animation: cat-assistant-sleep-once 1.25s ease-out forwards;
  }

  .cat-assistant__sleep-mark--small {
    font-size: 1.35rem;
  }

  .cat-assistant__sleep-mark--large {
    font-size: 2.2rem;
    animation-delay: 0.18s;
  }

  .cat-assistant:not([data-state='sleeping']) .cat-assistant__head,
  .cat-assistant:hover .cat-assistant__head {
    transform: translateY(-2px) rotate(-2.5deg);
  }

  .cat-assistant:not([data-state='sleeping']) .cat-assistant__eyes-sleep,
  .cat-assistant:hover .cat-assistant__eyes-sleep {
    opacity: 0;
    transform: scaleY(0.2);
  }

  .cat-assistant:not([data-state='sleeping']) .cat-assistant__eyes-awake,
  .cat-assistant:hover .cat-assistant__eyes-awake {
    opacity: 1;
    transform: scaleY(1);
  }

  .cat-assistant:not([data-state='sleeping']) .cat-assistant__sleep,
  .cat-assistant:hover .cat-assistant__sleep {
    opacity: 0;
    transform: translateY(-8px);
  }

  .cat-assistant[data-state='talking'] .cat-assistant__stage {
    animation:
      cat-assistant-breathe 4.8s ease-in-out infinite,
      cat-assistant-react 430ms ease;
  }

  .cat-assistant[data-state='talking'] .cat-assistant__tail,
  .cat-assistant[data-state='happy'] .cat-assistant__tail,
  .cat-assistant:hover .cat-assistant__tail {
    animation-duration: 1.8s;
  }

  .cat-assistant[data-state='happy'] .cat-assistant__stage {
    animation:
      cat-assistant-breathe 4.8s ease-in-out infinite,
      cat-assistant-happy 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes cat-assistant-react {
    0%,
    100% {
      transform: translateY(-4px) rotate(-1deg);
    }

    45% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  @keyframes cat-assistant-happy {
    0%,
    100% {
      transform: translateY(-4px) rotate(-1deg) scale(1);
    }

    38% {
      transform: translateY(-12px) rotate(3deg) scale(1.04);
    }

    68% {
      transform: translateY(-6px) rotate(-3deg) scale(1.02);
    }
  }

  @keyframes cat-assistant-breathe {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }

    50% {
      transform: translateY(-2px) rotate(-0.4deg);
    }
  }

  @keyframes cat-assistant-body-breathe {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(1px) scale(1.006, 0.994);
    }
  }

  @keyframes cat-assistant-tail-idle {
    0%,
    100% {
      transform: rotate(0deg);
    }

    50% {
      transform: rotate(3deg);
    }
  }

  @keyframes cat-assistant-sleep-once {
    0%,
    12% {
      opacity: 0;
      transform: translateY(7px) scale(0.86);
    }

    72%,
    100% {
      opacity: 0.86;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 900px) {
    .cat-assistant {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .cat-assistant {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-assistant,
    .cat-assistant__bubble,
    .cat-assistant__close,
    .cat-assistant__pet,
    .cat-assistant__stage,
    .cat-assistant__cat,
    .cat-assistant__tail,
    .cat-assistant__sleep-mark {
      animation: none !important;
      transition: none !important;
    }

    .cat-assistant,
    .cat-assistant.is-docked {
      transform: translate(0, 0) scale(1);
    }
  }
</style>
