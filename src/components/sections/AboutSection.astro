---
import SectionTitle from '../common/SectionTitle.astro';

const skills = {
  frontend: ['React', 'Next.js', 'React Native', 'Expo', 'TypeScript', 'HTML5 / CSS3', 'JavaScript'],
  backend: ['Node.js', 'Express', 'Python', 'FastAPI', 'REST APIs', 'PostgreSQL', 'MongoDB'],
  tools: ['Git & GitHub', 'Docker', 'Yarn / NPM', 'Vercel', 'Figma', 'Linux / Windows']
};
---

<section id="sobre-mi" class="about-section py-20">
  <div class="container">
    <SectionTitle 
      title="Sobre Mí" 
      subtitle="Trayectoria" 
    />

    <div class="about-grid grid grid-cols-2 md-grid-cols-1 gap-12 items-center">
      <!-- Profile Image & Info Card -->
      <div class="profile-card-wrapper">
        <div class="profile-avatar-container hover-glow">
          <div class="avatar-placeholder">
            <span class="avatar-initials">LV</span>
            <span class="avatar-ring"></span>
          </div>
          <!-- Real avatar photo if exists -->
          <img 
            src="/images/profile/avatar.jpg" 
            alt="Luis Vergel" 
            class="avatar-img" 
            onerror="this.style.display='none'"
          />
        </div>
        <div class="profile-meta mt-6 text-center">
          <h3 class="profile-name">Luis Vergel</h3>
          <p class="profile-title">Desarrollador Full Stack</p>
        </div>
      </div>

      <!-- Description and Skills -->
      <div class="about-info">
        <p class="about-text">
          Soy un desarrollador Full Stack apasionado por construir aplicaciones robustas e interactivas. Me encanta solucionar problemas lógicos complejos en el Backend y materializarlos en interfaces pulidas, intuitivas y eficientes en el Frontend.
        </p>
        <p class="about-text">
          Mi enfoque de desarrollo prioriza la calidad del código, el rendimiento y la escalabilidad, asegurando que cada proyecto cumpla con los estándares modernos de desarrollo de software.
        </p>

        <!-- Skill groups -->
        <div class="skills-wrapper mt-8">
          <h4 class="skills-title">Tecnologías y Herramientas</h4>
          
          <div class="skills-grid mt-4">
            <div class="skill-category">
              <h5 class="category-name">Frontend</h5>
              <ul class="skill-list">
                {skills.frontend.map(skill => <li class="skill-item">{skill}</li>)}
              </ul>
            </div>

            <div class="skill-category">
              <h5 class="category-name">Backend</h5>
              <ul class="skill-list">
                {skills.backend.map(skill => <li class="skill-item">{skill}</li>)}
              </ul>
            </div>

            <div class="skill-category">
              <h5 class="category-name">Herramientas</h5>
              <ul class="skill-list">
                {skills.tools.map(skill => <li class="skill-item">{skill}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    border-top: 1px solid var(--border-color);
  }

  /* Profile Card & Avatar Styles */
  .profile-card-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .profile-avatar-container {
    position: relative;
    width: 240px;
    height: 240px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 50% 50%, var(--surface-hover) 0%, var(--surface-color) 100%);
  }

  .avatar-initials {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .avatar-ring {
    position: absolute;
    inset: 20px;
    border: 2px dashed rgba(124, 77, 255, 0.15);
    border-radius: var(--radius-lg);
  }

  .avatar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 5;
  }

  .profile-name {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-primary);
  }

  .profile-title {
    font-size: var(--text-sm);
    color: var(--accent-primary);
    font-weight: 600;
    margin-top: 2px;
  }

  /* About Info & Skills Styles */
  .about-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-text {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .skills-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: var(--space-2);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  .category-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    position: relative;
    padding-left: var(--space-3);
  }

  .category-name::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--accent-primary);
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .skill-item {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    padding: var(--space-1) 0;
    transition: color var(--transition-fast);
  }

  .skill-item:hover {
    color: var(--text-primary);
  }
</style>
