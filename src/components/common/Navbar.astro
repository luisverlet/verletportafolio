---
import { DEFAULT_LANGUAGE, getTranslations } from '../../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const navCopy = getTranslations(DEFAULT_LANGUAGE).navbar;
---

<header class="site-header">
  <nav class="nav-shell" aria-label={navCopy.ariaLabel} data-site-nav data-i18n-aria-label="navbar.ariaLabel">
    <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>

    <ul class="nav-list">
      {navCopy.items.map((link, index) => (
        <li>
          <a href={link.url} class:list={['nav-link', { 'is-active': index === 0 }]} data-nav-link data-i18n={`navbar.items.${index}.name`}>
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-language-inline">
      <LanguageSwitcher />
    </div>

    <details class="nav-menu" data-nav-menu>
      <summary class="nav-menu__trigger" aria-label={navCopy.settingsLabel} data-i18n-aria-label="navbar.settingsLabel">
        <span class="nav-menu__bar" aria-hidden="true"></span>
        <span class="nav-menu__bar" aria-hidden="true"></span>
        <span class="nav-menu__bar" aria-hidden="true"></span>
      </summary>

      <div class="nav-menu__panel">
        <LanguageSwitcher />
        <ThemeToggle />
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: clamp(1.5rem, 4.5vh, 2.4rem);
    left: 0;
    z-index: var(--z-sticky);
    width: 100%;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .nav-shell {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    pointer-events: auto;
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    background: var(--color-navbar);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px);
    padding: 3px;
    overflow: hidden;
  }

  .nav-list {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list li {
    position: relative;
    z-index: 1;
  }

  .nav-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 0;
    width: var(--nav-indicator-width, 0px);
    height: var(--nav-indicator-height, 30px);
    border-radius: var(--radius-full);
    background: #ffffff;
    opacity: var(--nav-indicator-opacity, 0);
    transform: translate3d(var(--nav-indicator-x, 0px), -50%, 0);
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      width 260ms cubic-bezier(0.16, 1, 0.3, 1),
      height 260ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 160ms ease;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 30px;
    padding: 0 16px;
    border-radius: var(--radius-full);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease,
      font-weight 180ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #ffffff;
    opacity: 0.72;
  }

  .nav-link.is-active {
    color: #000000;
    font-weight: 700;
    opacity: 1;
  }

  .nav-theme-toggle {
    display: none;
    position: relative;
    z-index: 1;
  }

  .nav-language-inline {
    position: relative;
    z-index: 1;
  }

  .nav-menu {
    display: none;
    position: relative;
    z-index: 3;
    align-self: center;
    width: 38px;
    height: 30px;
  }

  .nav-menu__trigger {
    appearance: none;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 30px;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    cursor: pointer;
    line-height: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu__trigger::-webkit-details-marker {
    display: none;
  }

  .nav-menu__bar {
    display: block;
    width: 15px;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .nav-menu__bar + .nav-menu__bar {
    margin-top: 3px;
  }

  .nav-menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    gap: 0.55rem;
    min-width: 132px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    background: var(--color-navbar);
    box-shadow: var(--shadow-soft);
    padding: 0.55rem;
  }

  .nav-menu__panel :global(.language-switcher),
  .nav-menu__panel :global(.theme-toggle) {
    justify-self: end;
  }

  @media (max-width: 640px) {
    .site-header {
      top: 20px;
      padding: 0 var(--space-4);
    }

    .nav-shell {
      width: 100%;
      max-width: 460px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 3px;
      overflow: visible;
    }

    .nav-list {
      flex: 1 1 auto;
      justify-content: center;
      gap: 2px;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-list::-webkit-scrollbar {
      display: none;
    }

    .nav-language-inline {
      display: none;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-menu__panel :global(.theme-toggle) {
      width: 38px;
      height: 30px;
      border-color: rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.08);
      box-shadow: none;
      color: #ffffff;
    }

    .nav-menu__panel :global(.theme-toggle__track) {
      width: 27px;
      height: 16px;
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
    }

    .nav-menu__panel :global(.theme-toggle__thumb) {
      top: 2px;
      left: 2px;
      background: #ffffff;
    }

    .nav-menu__panel :global(.theme-toggle[data-theme-state='light'] .theme-toggle__thumb) {
      transform: translateX(11px);
    }

    .nav-link {
      min-height: 30px;
      padding: 0 6px;
      font-size: 0.66rem;
    }
  }

  @media (max-width: 390px) {
    .nav-link {
      padding: 0 5px;
      font-size: 0.62rem;
    }
  }
</style>

<script>
  function initSiteNav() {
    const nav = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!nav) return;
    if (nav.dataset.navReady === 'true') return;
    nav.dataset.navReady = 'true';

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const indicator = nav.querySelector<HTMLElement>('[data-nav-indicator]');
    const controller = new AbortController();
    const sectionMap = new Map<string, HTMLElement>();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pauseScrollSpyUntil = 0;

    const moveIndicator = (activeLink: HTMLAnchorElement | undefined) => {
      if (!indicator || !activeLink) return;

      const navRect = nav.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();

      nav.style.setProperty('--nav-indicator-x', `${linkRect.left - navRect.left}px`);
      nav.style.setProperty('--nav-indicator-width', `${linkRect.width}px`);
      nav.style.setProperty('--nav-indicator-height', `${linkRect.height}px`);
      nav.style.setProperty('--nav-indicator-opacity', '1');

      activeLink.scrollIntoView({
        block: 'nearest',
        inline: 'center',
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    };

    const getSectionScrollTop = (section: HTMLElement) => {
      if (section.id === 'inicio') return 0;

      const rect = section.getBoundingClientRect();
      const sectionTop = window.scrollY + rect.top;
      const viewportHeight = window.innerHeight;
      const navRect = nav.getBoundingClientRect();
      const topClearance = Math.ceil(navRect.bottom + (window.innerWidth <= 640 ? 22 : 30));
      const bottomClearance = window.innerWidth <= 640 ? 24 : 34;
      const readableHeight = viewportHeight - topClearance - bottomClearance;

      if (rect.height <= readableHeight) {
        return sectionTop - Math.max((viewportHeight - rect.height) / 2, topClearance);
      }

      const dividerTarget = window.innerWidth <= 640
        ? Math.max(navRect.top - 18, 8)
        : Math.max(navRect.top - 28, 8);

      return sectionTop - dividerTarget;
    };

    const scrollToSection = (targetHash: string, shouldUpdateHash = true) => {
      const section = sectionMap.get(targetHash);
      if (!section) return;

      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
      const top = Math.min(Math.max(getSectionScrollTop(section), 0), maxScroll);

      window.scrollTo({
        top,
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });

      if (shouldUpdateHash && window.location.hash !== targetHash) {
        window.history.pushState(null, '', targetHash);
      }
    };

    const setActiveLink = (targetHash: string) => {
      let activeLink: HTMLAnchorElement | undefined;

      links.forEach((link) => {
        const isActive = link.hash === targetHash;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }

        if (isActive) {
          activeLink = link;
        }
      });

      moveIndicator(activeLink);
    };

    links.forEach((link) => {
      const targetId = decodeURIComponent(link.hash.replace('#', ''));
      const section = document.getElementById(targetId);

      if (section) {
        sectionMap.set(link.hash, section);
      }

      link.addEventListener(
        'click',
        (event) => {
          event.preventDefault();
          pauseScrollSpyUntil = Date.now() + 1200;
          setActiveLink(link.hash);
          scrollToSection(link.hash);
        },
        { signal: controller.signal }
      );
    });

    nav.querySelectorAll<HTMLButtonElement>('[data-language-option], [data-theme-toggle]').forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          const menu = button.closest<HTMLDetailsElement>('[data-nav-menu]');
          if (menu) window.setTimeout(() => menu.removeAttribute('open'), 120);
        },
        { signal: controller.signal }
      );
    });

    const currentHash = window.location.hash;
    if (currentHash) {
      setActiveLink(currentHash);
      window.requestAnimationFrame(() => {
        scrollToSection(currentHash, false);
      });
    } else if (links[0]?.hash) {
      setActiveLink(links[0].hash);
    }

    window.addEventListener(
      'resize',
      () => {
        const activeLink = links.find((link) => link.classList.contains('is-active'));
        moveIndicator(activeLink);
      },
      { signal: controller.signal }
    );

    if (!('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        if (Date.now() < pauseScrollSpyUntil) return;

        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];

        if (visibleEntry?.target.id) {
          setActiveLink(`#${visibleEntry.target.id}`);
        }
      },
      {
        rootMargin: '-35% 0px -45% 0px',
        threshold: [0.08, 0.2, 0.4, 0.6]
      }
    );

    sectionMap.forEach((section) => observer.observe(section));

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        controller.abort();
      },
      { once: true }
    );
  }

  initSiteNav();

  document.addEventListener('astro:page-load', initSiteNav);
</script>
