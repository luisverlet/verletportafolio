---
import { DEFAULT_LANGUAGE, getTranslations } from '../../i18n';
import SectionTitle from '../common/SectionTitle.astro';
import ProjectCard from '../ui/ProjectCard.astro';

const copy = getTranslations(DEFAULT_LANGUAGE).projects;
const featuredProjects = copy.items
  .map((project, originalIndex) => ({ project, originalIndex }))
  .filter(({ project }) => project.featured);
---

<section id="proyectos" class="projects-section">
  <div class="container projects-container">
    <SectionTitle
      title={copy.title}
      subtitle={copy.subtitle}
      titleKey="projects.title"
      subtitleKey="projects.subtitle"
      align="left"
    />

    <div class="projects-grid" data-projects-grid>
      {featuredProjects.map(({ project, originalIndex }, index) => (
        <div
          class={`project-item reveal ${index >= 2 ? 'is-collapsible' : ''}`}
          data-collapsible={index >= 2 ? 'true' : undefined}
          style={`--delay: ${(index % 2) * 120}ms`}
        >
          <ProjectCard project={project} index={index} translationIndex={originalIndex} />
        </div>
      ))}
    </div>

    {featuredProjects.length > 2 && (
      <div class="projects-actions">
        <button
          type="button"
          class="btn-expand"
          data-expand-projects
          aria-expanded="false"
        >
          <span class="btn-expand__text" data-text-more="Ver más proyectos" data-text-less="Ver menos">
            Ver más proyectos
          </span>
          <svg class="btn-expand__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    )}
  </div>
</section>

<script>
  function initProjectsExpand() {
    const btn = document.querySelector<HTMLButtonElement>('[data-expand-projects]');
    const grid = document.querySelector<HTMLElement>('[data-projects-grid]');
    if (!btn || !grid || btn.dataset.ready === 'true') return;
    btn.dataset.ready = 'true';

    const collapsibleItems = Array.from(
      grid.querySelectorAll<HTMLElement>('.project-item[data-collapsible="true"]')
    );

    const textSpan = btn.querySelector<HTMLElement>('.btn-expand__text');
    const isEn = document.documentElement.lang === 'en' || document.documentElement.dataset.language === 'en';
    const moreText = isEn ? 'View more projects' : (textSpan?.dataset.textMore || 'Ver más proyectos');
    const lessText = isEn ? 'View less' : (textSpan?.dataset.textLess || 'Ver menos');

    if (textSpan) textSpan.textContent = moreText;

    // Make sure all collapsible items start hidden via inline style
    collapsibleItems.forEach((item) => {
      item.style.display = 'none';
      item.style.opacity = '0';
      item.style.transform = 'translateY(24px)';
    });

    function showItems() {
      collapsibleItems.forEach((item, i) => {
        item.style.display = 'flex';
        // Force reflow so transition fires
        item.getBoundingClientRect();
        item.style.transition = `opacity 420ms cubic-bezier(0.16, 1, 0.3, 1) ${i * 80}ms, transform 420ms cubic-bezier(0.16, 1, 0.3, 1) ${i * 80}ms`;
        item.style.opacity = '1';
        item.style.transform = 'translateY(0)';
      });
    }

    function hideItems() {
      collapsibleItems.forEach((item, i) => {
        item.style.transition = `opacity 280ms ease ${i * 40}ms, transform 280ms ease ${i * 40}ms`;
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        const delay = 280 + collapsibleItems.length * 40;
        setTimeout(() => { item.style.display = 'none'; }, delay);
      });
    }

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;

      btn.setAttribute('aria-expanded', String(nextExpanded));

      if (textSpan) {
        textSpan.textContent = nextExpanded ? lessText : moreText;
      }

      if (nextExpanded) {
        showItems();
      } else {
        hideItems();
      }
    });

    window.addEventListener('portfolio:language-change', (e: any) => {
      const currentLang = e.detail?.language;
      const isEnglish = currentLang === 'en';
      const mText = isEnglish ? 'View more projects' : 'Ver más proyectos';
      const lText = isEnglish ? 'View less' : 'Ver menos';
      const isCurrentlyExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (textSpan) {
        textSpan.textContent = isCurrentlyExpanded ? lText : mText;
      }
    });
  }

  initProjectsExpand();
  document.addEventListener('astro:page-load', initProjectsExpand);
</script>

<style>
  .projects-section {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vh, 7rem) 0;
    border-top: 1px solid var(--border-color);
    background:
      radial-gradient(circle at 18% 6%, rgba(var(--color-lilac), 0.055), transparent 24rem),
      radial-gradient(circle at 88% 58%, rgba(var(--color-lilac), 0.035), transparent 22rem);
  }

  .projects-section::before,
  .projects-section::after {
    content: none;
  }

  .projects-container {
    position: relative;
    z-index: 1;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    align-items: stretch;
    max-width: 1050px;
    margin-top: var(--space-12);
    margin-inline: auto;
  }

  .project-item {
    display: flex;
    min-width: 0;
  }

  .project-item.is-collapsible {
    /* display controlled by JS */
    display: none;
  }

  .projects-actions {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  .btn-expand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background:
      linear-gradient(145deg, rgba(var(--color-accent-primary-rgb), 0.06), transparent 50%),
      color-mix(in srgb, var(--color-surface) 90%, transparent);
    color: var(--color-text-primary);
    font-size: 0.94rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(12px);
    transition:
      border-color var(--transition-normal),
      background var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .btn-expand:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    color: var(--color-lilac-text);
  }

  .btn-expand__icon {
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-expand[aria-expanded='true'] .btn-expand__icon {
    transform: rotate(180deg);
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
  }

</style>
