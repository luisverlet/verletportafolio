---
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import CatAssistant from '../components/ui/CatAssistant.astro';
import PersonalTechBackground from '../components/background/PersonalTechBackground.astro';
import { DEFAULT_LANGUAGE, getTranslations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const defaultCopy = getTranslations(DEFAULT_LANGUAGE);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const {
  title = defaultCopy.seo.title,
  description = defaultCopy.seo.description
} = Astro.props;
---

<!DOCTYPE html>
<html lang={DEFAULT_LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        try {
          const storedTheme = window.localStorage.getItem('portfolio-theme');
          const theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : 'light';

          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', theme === 'light' ? '#ffffff' : '#000000');

          const storedLanguage = window.localStorage.getItem('portfolio-language');
          const browserLanguages = Array.isArray(navigator.languages) && navigator.languages.length
            ? navigator.languages
            : [navigator.language || 'es'];
          const language = storedLanguage === 'es' || storedLanguage === 'en'
            ? storedLanguage
            : browserLanguages.some((locale) => locale.toLowerCase().startsWith('es'))
              ? 'es'
              : 'en';

          document.documentElement.lang = language;
          document.documentElement.dataset.language = language;
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.style.colorScheme = 'light';
          document.documentElement.lang = 'es';
          document.documentElement.dataset.language = 'es';
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Google Fonts Preconnect and Non-blocking Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Display:wght@400;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="title" content={title} data-i18n-content="seo.title" />
    <meta name="description" content={description} data-i18n-content="seo.description" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-content="seo.title" />
    <meta property="og:description" content={description} data-i18n-content="seo.description" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} data-i18n-content="seo.title" />
    <meta property="twitter:description" content={description} data-i18n-content="seo.description" />
  </head>
  <body>
    <div id="page-loader" class="page-loader" aria-hidden="false">
      <div class="page-loader__content">
        <div class="page-loader__logo-container">
          <svg class="page-loader__logo-svg" viewBox="0 0 100 100" width="80" height="80">
            <path d="M22 75 C20 60 24 40 30 28 C32 24 36 26 40 36 C44 46 47 48 50 48 C53 48 56 46 60 36 C64 26 68 24 70 28 C76 40 80 60 78 75 C78 75 50 81 22 75 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="page-loader__progress-bar">
          <div class="page-loader__progress-fill" id="page-loader-fill"></div>
        </div>
        <div class="page-loader__percentage" id="page-loader-percentage">0%</div>
        <div class="page-loader__status" id="page-loader-status">Cargando recursos...</div>
      </div>
    </div>
    <script is:inline>
      (() => {
        const loader = document.getElementById('page-loader');
        const fill = document.getElementById('page-loader-fill');
        const percentage = document.getElementById('page-loader-percentage');
        const status = document.getElementById('page-loader-status');

        if (!loader || !fill || !percentage || !status) return;

        document.body.classList.add('is-loading');

        const esText = 'Cargando recursos...';
        const enText = 'Loading resources...';
        const isEn = document.documentElement.lang === 'en' || document.documentElement.dataset.language === 'en';
        status.textContent = isEn ? enText : esText;

        let currentProgress = 0;
        let targetProgress = 40;
        let animationFrame = null;
        let isDone = false;

        const render = () => {
          if (currentProgress < targetProgress) {
            const diff = targetProgress - currentProgress;
            currentProgress += Math.max(diff * 0.15, 0.5);
            if (currentProgress > 100) currentProgress = 100;
            const intVal = Math.round(currentProgress);
            fill.style.width = `${intVal}%`;
            percentage.textContent = `${intVal}%`;
          }

          if (currentProgress < 100 || !isDone) {
            animationFrame = requestAnimationFrame(render);
          } else {
            fill.style.width = '100%';
            percentage.textContent = '100%';
            setTimeout(() => {
              loader.classList.add('is-loaded');
              document.body.classList.remove('is-loading');
              setTimeout(() => {
                loader.style.display = 'none';
              }, 500);
            }, 250);
          }
        };

        animationFrame = requestAnimationFrame(render);

        setTimeout(() => {
          if (targetProgress < 85) targetProgress = 85;
        }, 350);

        const finishLoading = () => {
          if (isDone) return;
          isDone = true;
          targetProgress = 100;
        };

        if (document.readyState === 'complete') {
          finishLoading();
        } else {
          window.addEventListener('load', finishLoading, { once: true });
          setTimeout(finishLoading, 1500);
        }
      })();
    </script>

    <PersonalTechBackground />
    <Navbar />
    <div class="theme-toggle-floating">
      <ThemeToggle />
    </div>

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <CatAssistant />

    <script>
      import '../scripts/theme';
      import '../scripts/i18n';
      import '../scripts/reveal-on-scroll';
      import '../scripts/cat-assistant';
    </script>
    <script is:inline>
      (() => {
        if (window.location.pathname.startsWith('/admin')) return;

        const visitorStorageKey = 'visitor_id';
        const sessionStorageKey = 'session_id';

        const createId = () => {
          if (window.crypto?.randomUUID) {
            return window.crypto.randomUUID();
          }

          return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
        };

        const getStoredId = (storage, key) => {
          try {
            const existingId = storage.getItem(key);
            if (existingId) return existingId;

            const id = createId();
            storage.setItem(key, id);
            return id;
          } catch {
            return createId();
          }
        };

        const payload = {
          visitorId: getStoredId(window.localStorage, visitorStorageKey),
          sessionId: getStoredId(window.sessionStorage, sessionStorageKey),
          page: window.location.pathname,
          referrer: document.referrer || null,
          language: navigator.language || null,
          screenWidth: window.screen?.width || null,
          screenHeight: window.screen?.height || null,
          userAgent: navigator.userAgent || null,
        };

        const sendTrackingEvent = () => {
          fetch('/api/track', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(() => {
            // Analytics must never interrupt the visitor experience.
          });
        };

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(sendTrackingEvent, { timeout: 2500 });
        } else {
          window.setTimeout(sendTrackingEvent, 1200);
        }
      })();
    </script>
  </body>
</html>

<style>
  .theme-toggle-floating {
    position: fixed;
    top: clamp(1.5rem, 4.5vh, 2.4rem);
    right: clamp(1rem, 3vw, 2rem);
    z-index: calc(var(--z-sticky) + 1);
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .theme-toggle-floating {
      display: none;
    }
  }

  /* Page Loader Styles */
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: grid;
    place-items: center;
    background-color: var(--color-bg, #030308);
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1), visibility 500ms;
    will-change: opacity;
  }

  :global(html[data-theme='light']) .page-loader {
    background-color: #ffffff;
  }

  .page-loader__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: min(320px, 80vw);
    text-align: center;
  }

  .page-loader__logo-container {
    color: var(--color-lilac-text, #cdb7ff);
    animation: loader-pulse 2s ease-in-out infinite;
  }

  .page-loader__logo-svg {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: stroke-draw 2.5s ease-out forwards;
  }

  .page-loader__progress-bar {
    width: 100%;
    height: 4px;
    background-color: rgba(118, 76, 255, 0.1);
    border-radius: 99px;
    overflow: hidden;
  }

  .page-loader__progress-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #764cff, #c6b4ff);
    border-radius: inherit;
    transition: width 200ms ease-out;
  }

  .page-loader__percentage {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-primary, #ffffff);
    font-variant-numeric: tabular-nums;
  }

  :global(html[data-theme='light']) .page-loader__percentage {
    color: #19122e;
  }

  .page-loader__status {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted, rgba(255, 255, 255, 0.6));
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .page-loader.is-loaded {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  :global(body.is-loading) {
    overflow: hidden !important;
  }

  @keyframes loader-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.95;
    }
    50% {
      transform: scale(1.03);
      opacity: 1;
    }
  }

  @keyframes stroke-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
