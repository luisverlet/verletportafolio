---
import type { Project } from '../../data/projects';
import jookerpLaptop from '../../assets/images/JookERP_LAPTOPTHOME.png';
import menteSeguraLaptop from '../../assets/images/MenteSegura_LAPTOPTHOME.png';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const visualMap = {
  'mentesegura-mobile': {
    image: menteSeguraLaptop.src
  },
  'jookerp-demand': {
    image: jookerpLaptop.src
  }
} as const;

const visual = visualMap[project.id as keyof typeof visualMap];
const imageSrc = visual?.image ?? project.image;
const CardElement = project.demoUrl ? 'a' : 'article';
const cardProps = project.demoUrl
  ? {
      href: project.demoUrl,
      target: '_blank',
      rel: 'noreferrer',
      'aria-label': `Abrir proyecto ${project.title}`
    }
  : {};
---

<CardElement class="project-card" {...cardProps}>
  <div class="project-kicker">
    <span>{String(index + 1).padStart(2, '0')}</span>
    <span>{project.category}</span>
  </div>

  <div class="project-visual">
    <img
      src={imageSrc}
      alt={`Vista de laptop del proyecto ${project.title}`}
      class="project-img"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="project-content">
    <h3 class="project-title">{project.title}</h3>

    <dl class="project-meta">
      <div>
        <dt>Participación</dt>
        <dd>Diseño técnico y desarrollo Full Stack</dd>
      </div>

      <div>
        <dt>Stack</dt>
        <dd>{project.tags.join(', ')}</dd>
      </div>
    </dl>

    <p class="project-description">{project.description}</p>

    {project.demoUrl && <span class="project-link">Explorar proyecto -></span>}
  </div>
</CardElement>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background:
      linear-gradient(145deg, rgba(var(--color-accent-primary-rgb), 0.035), transparent 44%),
      color-mix(in srgb, var(--color-card) 82%, transparent);
    box-shadow: var(--shadow-soft);
    color: var(--color-text-primary);
    padding: clamp(1rem, 2vw, 1.25rem);
    text-decoration: none;
    transform: translateY(0);
    backdrop-filter: blur(18px);
    transition:
      border-color var(--transition-normal),
      box-shadow var(--transition-normal),
      background-color var(--transition-normal),
      transform var(--transition-normal);
  }

  .project-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(var(--color-accent-primary-rgb), 0.07), transparent 42%);
    opacity: 0.16;
    pointer-events: none;
    transform: translate3d(-1.5%, -1.5%, 0);
    animation: project-card-aura 7.5s ease-in-out infinite alternate;
    transition: opacity var(--transition-normal);
  }

  .project-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
    transform: translateY(-8px);
  }

  .project-card:hover::after {
    opacity: 0.34;
  }

  .project-card:hover .project-kicker,
  .project-card:hover .project-link {
    color: var(--color-lilac-text);
  }

  .project-kicker {
    display: flex;
    position: relative;
    z-index: 1;
    align-items: center;
    justify-content: space-between;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .project-visual {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    aspect-ratio: 1.18 / 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--color-border);
    background:
      linear-gradient(145deg, rgba(var(--color-accent-primary-rgb), 0.035), transparent 46%),
      color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .project-visual::before {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: inherit;
    pointer-events: none;
  }

  .project-img {
    position: relative;
    z-index: 1;
    width: min(84%, 360px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, 0.24));
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-img {
    transform: translateY(-6px) scale(1.03);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 8px;
    border-radius: 8px;
  }

  .project-content {
    display: grid;
    position: relative;
    z-index: 1;
    gap: 0.75rem;
    flex: 1;
    grid-template-rows: auto auto 1fr auto;
    text-align: left;
  }

  @keyframes project-card-aura {
    0% {
      transform: translate3d(-1.5%, -1.5%, 0);
    }

    100% {
      transform: translate3d(1.5%, 1.5%, 0);
    }
  }

  .project-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.18rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .project-meta {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .project-meta div {
    display: grid;
    gap: 0.08rem;
  }

  .project-meta dt {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.08;
    text-transform: uppercase;
  }

  .project-meta dd {
    margin: 0;
    max-width: none;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .project-description {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  .project-link {
    display: inline-flex;
    width: fit-content;
    color: var(--text-primary);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1;
    transition: transform var(--transition-normal);
  }

  .project-card:hover .project-link {
    transform: translateX(4px);
  }

  @media (max-width: 820px) {
    .project-visual {
      aspect-ratio: 1.16 / 1;
    }

    .project-img {
      width: min(82%, 340px);
    }
  }

  @media (max-width: 460px) {
    .project-visual {
      aspect-ratio: 1.08 / 1;
    }

    .project-img {
      width: 88%;
    }

    .project-title {
      font-size: 1.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card::after,
    .project-img {
      transition: none;
      animation: none;
    }

    .project-card:hover,
    .project-card:hover .project-img {
      transform: none;
    }
  }
</style>
