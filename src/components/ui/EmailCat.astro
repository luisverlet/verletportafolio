---
interface Props {
  email?: string;
  label?: string;
  className?: string;
  variant?: 'compact' | 'featured';
}

const {
  email = 'luisverlet@gmail.com',
  label,
  className = '',
  variant = 'featured'
} = Astro.props;
---

<div class={`email-cat email-cat--${variant} ${className}`} data-email-cat data-email={email}>
  <div class="email-cat__stage" aria-hidden="true">
    <div class="email-cat__bubble" data-email-cat-message>Un clic y tienes el correo</div>

    <div class="email-cat__lottie" data-email-cat-lottie></div>

    <div class="email-cat__fallback" data-email-cat-fallback>
      <svg class="email-cat__svg" viewBox="0 0 260 165" role="img" aria-label="Gato dormido">
        <defs>
          <linearGradient id="catBodyGradient" x1="38" y1="48" x2="220" y2="145" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#34363a" />
            <stop offset="1" stop-color="#181a1d" />
          </linearGradient>
          <linearGradient id="catHeadGradient" x1="114" y1="28" x2="192" y2="116" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#3b3d41" />
            <stop offset="1" stop-color="#202226" />
          </linearGradient>
        </defs>

        <g class="email-cat__sleep">
          <text class="email-cat__sleep-mark email-cat__sleep-mark--small" x="99" y="25">z</text>
          <text class="email-cat__sleep-mark email-cat__sleep-mark--large" x="118" y="17">Z</text>
        </g>

        <g class="email-cat__cat">
          <path
            class="email-cat__body-shape"
            d="M31.2 116.6c0-29.3 23.7-53.1 57.7-53.1 22 0 36.9 9.1 47.8 23.2 7.1 9.2 15.4 19.6 33 19.6h21.8c14.6 0 26.5 10.9 26.5 24.3 0 12.2-8.3 21.6-21.7 21.6H58.4c-17.1 0-27.2-15.2-27.2-35.6Z"
          />

          <path
            class="email-cat__belly-line"
            d="M61.4 126.4c14.8-9.4 36-8.6 47.7 2.9"
          />

          <path
            class="email-cat__tail"
            d="M202.9 125.2c24.5-1.3 39.7-17.5 34.3-36.8-2.3-8.1-11.7-7.6-12.7.7-.7 6 3.8 11.5 10 11.7"
          />

          <g class="email-cat__head">
            <path
              class="email-cat__head-shape"
              d="M120.4 106.4c-11.8-9-15.4-27.8-10.5-51.2 1.8-8.5 4.7-22.2 9.2-23 4.8-.8 17 17.3 22.9 24.7 6.5-2.1 13.6-3.1 21-3.1 7.2 0 14 1 20.3 3 5.8-7.5 18.2-25.7 23-24.6 4.5 1 7.3 14.8 8.9 23.4 4.4 23.3.6 42-11.2 50.8-9.5 7.1-22 10.5-41.8 10.5-19.6 0-32.3-3.4-41.8-10.5Z"
            />
            <path class="email-cat__inner-ear email-cat__inner-ear--left" d="M121.2 48.3 134.6 68l-20.7 8.7c.4-11.7 2.8-22 7.3-28.4Z" />
            <path class="email-cat__inner-ear email-cat__inner-ear--right" d="M205 48.3 191.6 68l20.7 8.7c-.4-11.7-2.8-22-7.3-28.4Z" />

            <g class="email-cat__eyes-sleep">
              <path d="M142.2 82.6c3.5 4.2 8.8 4.2 12.3 0" />
              <path d="M171.4 82.6c3.5 4.2 8.8 4.2 12.3 0" />
            </g>

            <g class="email-cat__eyes-awake">
              <ellipse cx="148.8" cy="83.8" rx="8.2" ry="9.8" />
              <ellipse cx="178" cy="83.8" rx="8.2" ry="9.8" />
              <circle cx="150.9" cy="81" r="2.7" />
              <circle cx="180.1" cy="81" r="2.7" />
            </g>

            <path
              class="email-cat__face-detail email-cat__brows"
              d="M143.3 72.3c3.1-2.4 6.3-2.4 9.4 0M172.4 72.3c3.1-2.4 6.3-2.4 9.4 0"
            />
            <path class="email-cat__nose" d="M158.4 91.7c2.6-4.1 7.4-4.1 10 0-2.2 4.1-7.8 4.1-10 0Z" />
            <path class="email-cat__mouth" d="M163.4 96.8c-2.6 6.2-10 6.5-13.6 1.7M163.4 96.8c2.6 6.2 10 6.5 13.6 1.7" />
            <path class="email-cat__whiskers" d="M128.8 94h20.5M128.9 104.2l20.4-4.1M197.9 94h-20.5M197.8 104.2l-20.4-4.1" />
          </g>

          <g class="email-cat__paws">
            <path d="M117.2 144.8c-.9-11.1 5.1-16.5 14-16.5 8.7 0 13.8 5.5 13.2 16.5" />
            <path d="M158.2 144.8c-.9-11.1 5.1-16.5 14-16.5 8.7 0 13.8 5.5 13.2 16.5" />
            <path class="email-cat__paw-lines" d="M127.8 139.6v5.2M136.7 139.6v5.2M168.8 139.6v5.2M177.7 139.6v5.2" />
          </g>
        </g>
      </svg>
    </div>
  </div>

  {label && <span class="email-cat__label">{label}</span>}

  <button
    type="button"
    class="email-cat__button"
    data-email-cat-button
    aria-label={`Copiar correo ${email}`}
  >
    <span class="email-cat__text">{email}</span>
  </button>

  <span class="email-cat__live" data-email-cat-live aria-live="polite"></span>
</div>

<style>
  .email-cat {
    --email-cat-bg: rgba(255, 255, 255, 0.9);
    --email-cat-bg-hover: rgba(255, 255, 255, 0.98);
    --email-cat-bg-active: #ffffff;
    --email-cat-ink: var(--color-ink, #08020a);
    --email-cat-shadow: 0 14px 30px rgba(0, 0, 0, 0.16);
    --email-cat-border: rgba(255, 255, 255, 0);

    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    width: fit-content;
    max-width: 100%;
    color: var(--email-cat-ink);
  }

  :global(html[data-theme='light']) .email-cat {
    --email-cat-bg: rgba(255, 255, 255, 0.92);
    --email-cat-bg-hover: #ffffff;
    --email-cat-bg-active: #ffffff;
    --email-cat-ink: var(--color-text-primary);
    --email-cat-shadow: 0 14px 30px rgba(18, 18, 18, 0.12);
    --email-cat-border: var(--color-border);
  }

  .email-cat__stage {
    position: absolute;
    right: 5px;
    bottom: calc(100% - 5px);
    z-index: 2;
    width: clamp(58px, 5.2vw, 72px);
    height: clamp(37px, 3.4vw, 46px);
    pointer-events: none;
    transform-origin: 72% 100%;
    transition: transform 220ms ease;
  }

  .email-cat--compact .email-cat__stage {
    width: 58px;
    height: 37px;
  }

  .email-cat--featured .email-cat__stage {
    width: clamp(72px, 8vw, 104px);
    height: clamp(46px, 5.5vw, 66px);
  }

  .email-cat__lottie,
  .email-cat__fallback {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .email-cat__lottie {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .email-cat.is-lottie-ready .email-cat__lottie {
    opacity: 1;
  }

  .email-cat.is-lottie-ready .email-cat__fallback {
    opacity: 0;
  }

  .email-cat__fallback {
    filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.18));
    opacity: 1;
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .email-cat__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .email-cat__cat {
    animation: email-cat-breathe 4.8s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 54% 82%;
  }

  .email-cat__body-shape,
  .email-cat__head-shape {
    fill: url(#catBodyGradient);
  }

  .email-cat__head-shape {
    fill: url(#catHeadGradient);
  }

  .email-cat__tail {
    fill: none;
    stroke: #222428;
    stroke-width: 18;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: email-cat-tail-idle 4.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 6% 94%;
  }

  .email-cat__belly-line,
  .email-cat__mouth,
  .email-cat__whiskers,
  .email-cat__eyes-sleep path,
  .email-cat__brows,
  .email-cat__paws path {
    fill: none;
    stroke: rgba(222, 226, 232, 0.58);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .email-cat__belly-line {
    stroke-width: 4;
    opacity: 0.35;
  }

  .email-cat__inner-ear {
    fill: rgba(10, 11, 14, 0.36);
  }

  .email-cat__head {
    transform-box: fill-box;
    transform-origin: 50% 76%;
    transition: transform 220ms ease;
  }

  .email-cat__eyes-sleep {
    opacity: 1;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .email-cat__eyes-sleep path {
    stroke-width: 4;
  }

  .email-cat__eyes-awake {
    opacity: 0;
    transform: scaleY(0.3);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 140ms ease, transform 140ms ease;
  }

  .email-cat__eyes-awake ellipse {
    fill: #f5f6f8;
    stroke: rgba(255, 255, 255, 0.72);
    stroke-width: 2;
  }

  .email-cat__eyes-awake circle {
    fill: #111216;
  }

  .email-cat__brows {
    stroke-width: 3;
    opacity: 0.28;
  }

  .email-cat__nose {
    fill: #d9dde5;
  }

  .email-cat__mouth {
    stroke-width: 3.6;
  }

  .email-cat__whiskers {
    stroke-width: 3;
    opacity: 0.72;
  }

  .email-cat__paws path {
    stroke-width: 10;
    opacity: 0.56;
  }

  .email-cat__paws .email-cat__paw-lines {
    stroke-width: 2.2;
    opacity: 0.36;
  }

  .email-cat__sleep {
    opacity: 1;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .email-cat__sleep-mark {
    fill: rgba(30, 32, 35, 0.82);
    font-weight: 700;
    line-height: 1;
    transform-origin: center;
    animation: email-cat-sleep-once 1.25s ease-out forwards;
  }

  .email-cat__sleep-mark--small {
    font-size: 1.35rem;
  }

  .email-cat__sleep-mark--large {
    font-size: 2.2rem;
    animation-delay: 0.18s;
  }

  .email-cat__bubble {
    position: absolute;
    right: -10px;
    bottom: calc(100% + 8px);
    width: fit-content;
    max-width: min(230px, 78vw);
    border-radius: 8px;
    border: 1px solid var(--email-cat-border);
    background: var(--email-cat-bg-hover);
    color: var(--email-cat-ink);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.15;
    opacity: 0;
    padding: 9px 12px;
    transform: translateY(6px) scale(0.98);
    transition: opacity 160ms ease, transform 160ms ease;
    white-space: normal;
  }

  .email-cat__bubble::after {
    content: '';
    position: absolute;
    right: 28px;
    top: 100%;
    width: 12px;
    height: 12px;
    background: inherit;
    transform: translateY(-6px) rotate(45deg);
  }

  .email-cat__label {
    margin-bottom: 6px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 400;
  }

  .email-cat__button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: min(100%, 92vw);
    border: 1px solid var(--email-cat-border);
    border-radius: 5px;
    background: var(--email-cat-bg);
    color: var(--email-cat-ink);
    cursor: pointer;
    font: inherit;
    font-size: 1.18rem;
    font-weight: 400;
    line-height: 1.15;
    padding: 7px 10px 8px;
    transform: translateY(0);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .email-cat--compact .email-cat__button {
    font-size: 1rem;
    padding: 7px 10px 8px;
  }

  .email-cat--featured .email-cat__button {
    font-size: clamp(1.12rem, 2vw, 1.45rem);
    padding: 9px 13px 10px;
  }

  .email-cat__button:hover,
  .email-cat__button:focus-visible {
    background: var(--email-cat-bg-hover);
    box-shadow: var(--email-cat-shadow);
    transform: translateY(-3px);
  }

  .email-cat__button:active {
    transform: translateY(-1px) scale(0.992);
  }

  .email-cat__text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .email-cat__live {
    position: absolute;
    width: 1px;
    height: 1px;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  .email-cat.is-hovering .email-cat__stage,
  .email-cat:focus-within .email-cat__stage {
    transform: translateY(-4px) rotate(-1deg);
  }

  .email-cat.is-hovering .email-cat__head,
  .email-cat:focus-within .email-cat__head,
  .email-cat.has-message .email-cat__head {
    transform: translateY(-2px) rotate(-2.5deg);
  }

  .email-cat.is-hovering .email-cat__eyes-sleep,
  .email-cat:focus-within .email-cat__eyes-sleep,
  .email-cat.has-message .email-cat__eyes-sleep {
    opacity: 0;
    transform: scaleY(0.2);
  }

  .email-cat.is-hovering .email-cat__eyes-awake,
  .email-cat:focus-within .email-cat__eyes-awake,
  .email-cat.has-message .email-cat__eyes-awake {
    opacity: 1;
    transform: scaleY(1);
  }

  .email-cat.is-hovering .email-cat__sleep,
  .email-cat:focus-within .email-cat__sleep,
  .email-cat.has-message .email-cat__sleep {
    opacity: 0;
    transform: translateY(-8px);
  }

  .email-cat.is-hovering .email-cat__bubble,
  .email-cat:focus-within .email-cat__bubble,
  .email-cat.has-message .email-cat__bubble {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .email-cat.is-hovering .email-cat__tail,
  .email-cat:focus-within .email-cat__tail {
    animation-duration: 1.8s;
  }

  .email-cat.is-reacting .email-cat__stage {
    animation: email-cat-react 430ms ease;
  }

  .email-cat.is-reacting .email-cat__tail {
    animation: email-cat-tail-react 430ms ease;
  }

  .email-cat.is-copied .email-cat__button {
    background: var(--email-cat-bg-active);
    box-shadow: var(--email-cat-shadow);
  }

  .email-cat.is-copied .email-cat__stage {
    animation: email-cat-happy 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .email-cat.is-error .email-cat__button {
    background: rgba(255, 236, 236, 0.94);
  }

  @keyframes email-cat-react {
    0%,
    100% {
      transform: translateY(-4px) rotate(-1deg);
    }

    45% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  @keyframes email-cat-happy {
    0%,
    100% {
      transform: translateY(-4px) rotate(-1deg) scale(1);
    }

    38% {
      transform: translateY(-12px) rotate(3deg) scale(1.04);
    }

    68% {
      transform: translateY(-6px) rotate(-3deg) scale(1.02);
    }
  }

  @keyframes email-cat-breathe {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(1px) scale(1.006, 0.994);
    }
  }

  @keyframes email-cat-tail-idle {
    0%,
    100% {
      transform: rotate(0deg);
    }

    50% {
      transform: rotate(3deg);
    }
  }

  @keyframes email-cat-tail-react {
    0%,
    100% {
      transform: rotate(0deg);
    }

    45% {
      transform: rotate(10deg);
    }
  }

  @keyframes email-cat-sleep-once {
    0%,
    12% {
      opacity: 0;
      transform: translateY(7px) scale(0.86);
    }

    72%,
    100% {
      opacity: 0.86;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 520px) {
    .email-cat {
      align-items: stretch;
      max-width: 100%;
    }

    .email-cat__stage {
      display: none;
    }

    .email-cat__button {
      width: 100%;
      padding: 7px 9px 8px;
      font-size: 1rem;
    }

    .email-cat__bubble {
      right: 0;
      max-width: min(250px, 76vw);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .email-cat__stage {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .email-cat *,
    .email-cat *::before,
    .email-cat *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 1ms !important;
    }

    .email-cat__button:hover,
    .email-cat__button:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  import lottie from 'lottie-web';
  import type { AnimationItem } from 'lottie-web';

  type EmailCatState = {
    destroy: () => void;
  };

  const LOTTIE_PATH = '/animations/cat.json';
  const IDLE_MESSAGE = 'Un clic y tienes el correo';
  const COPIED_MESSAGE = 'Correo copiado. Listo para hablar';
  const ERROR_MESSAGE = 'No se pudo copiar';
  const registryKey = '__emailCatRegistry';
  const windowWithRegistry = window as typeof window & {
    [registryKey]?: WeakMap<HTMLElement, EmailCatState>;
  };
  const registry = windowWithRegistry[registryKey] ?? new WeakMap<HTMLElement, EmailCatState>();
  windowWithRegistry[registryKey] = registry;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(pointer: fine)');

  function initEmailCat(widget: HTMLElement) {
    registry.get(widget)?.destroy();

    const button = widget.querySelector<HTMLButtonElement>('[data-email-cat-button]');
    const bubble = widget.querySelector<HTMLElement>('[data-email-cat-message]');
    const liveRegion = widget.querySelector<HTMLElement>('[data-email-cat-live]');
    const lottieContainer = widget.querySelector<HTMLElement>('[data-email-cat-lottie]');
    const email = widget.dataset.email || 'luisverlet@gmail.com';
    const controller = new AbortController();
    let animation: AnimationItem | null = null;
    let messageTimer: number | undefined;
    let reactionTimer: number | undefined;

    const clearTimers = () => {
      if (messageTimer) window.clearTimeout(messageTimer);
      if (reactionTimer) window.clearTimeout(reactionTimer);
      messageTimer = undefined;
      reactionTimer = undefined;
    };

    const setBubbleMessage = (message: string) => {
      bubble?.replaceChildren(message);
      liveRegion?.replaceChildren(message);
    };

    const showResult = (message: string, state: 'copied' | 'error') => {
      clearTimers();
      setBubbleMessage(message);
      widget.classList.add('has-message', state === 'copied' ? 'is-copied' : 'is-error');
      widget.classList.remove(state === 'copied' ? 'is-error' : 'is-copied');

      messageTimer = window.setTimeout(() => {
        widget.classList.remove('has-message', 'is-copied', 'is-error');
        setBubbleMessage(IDLE_MESSAGE);
        liveRegion?.replaceChildren();
      }, 2200);
    };

    const reactCat = () => {
      widget.classList.remove('is-reacting');
      void widget.offsetWidth;
      widget.classList.add('is-reacting');

      if (animation && !reducedMotion.matches) {
        animation.setSpeed(1.2);
        animation.goToAndPlay(0, true);
      }

      reactionTimer = window.setTimeout(() => {
        widget.classList.remove('is-reacting');
        animation?.setSpeed(widget.classList.contains('is-hovering') ? 0.95 : 0.45);
      }, 460);
    };

    const copyEmail = async () => {
      try {
        await navigator.clipboard.writeText(email);
        showResult(COPIED_MESSAGE, 'copied');
        reactCat();
      } catch {
        showResult(ERROR_MESSAGE, 'error');
      }
    };

    const loadLottie = async () => {
      if (!lottieContainer || reducedMotion.matches || !finePointer.matches) return;

      try {
        const response = await fetch(LOTTIE_PATH, { method: 'HEAD' });
        if (!response.ok) return;

        animation = lottie.loadAnimation({
          container: lottieContainer,
          renderer: 'svg',
          loop: true,
          autoplay: false,
          path: LOTTIE_PATH
        });

        animation.setSpeed(0.45);
        animation.addEventListener('DOMLoaded', () => {
          widget.classList.add('is-lottie-ready');
        });
        animation.addEventListener('data_failed', () => {
          animation?.destroy();
          animation = null;
          widget.classList.remove('is-lottie-ready');
        });
      } catch {
        animation = null;
      }
    };

    button?.addEventListener('click', copyEmail, { signal: controller.signal });

    widget.addEventListener(
      'mouseenter',
      () => {
        widget.classList.add('is-hovering');
        setBubbleMessage(IDLE_MESSAGE);
        if (!reducedMotion.matches) {
          animation?.setSpeed(0.95);
          animation?.play();
        }
      },
      { signal: controller.signal }
    );

    widget.addEventListener(
      'mouseleave',
      () => {
        widget.classList.remove('is-hovering');
        animation?.setSpeed(0.45);
        animation?.pause();
      },
      { signal: controller.signal }
    );

    button?.addEventListener(
      'focus',
      () => {
        widget.classList.add('is-hovering');
        setBubbleMessage(IDLE_MESSAGE);
      },
      { signal: controller.signal }
    );

    button?.addEventListener(
      'blur',
      () => {
        widget.classList.remove('is-hovering');
      },
      { signal: controller.signal }
    );

    loadLottie();

    registry.set(widget, {
      destroy: () => {
        controller.abort();
        clearTimers();
        animation?.destroy();
        animation = null;
        widget.classList.remove('is-lottie-ready', 'is-hovering', 'is-reacting', 'has-message', 'is-copied', 'is-error');
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-email-cat]').forEach(initEmailCat);

  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<HTMLElement>('[data-email-cat]').forEach((widget) => {
      registry.get(widget)?.destroy();
    });
  });
</script>
