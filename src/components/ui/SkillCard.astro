---
import type { SkillGroup } from '../../data/skills';

interface Props {
  group: SkillGroup;
  index: number;
}

const { group, index } = Astro.props;
---

<article class="skill-card reveal reveal-up" style={`--delay: ${index * 90}ms`}>
  <div class="skill-card__index">{String(index + 1).padStart(2, '0')}</div>
  <div class="skill-card__content">
    <h3 class="skill-card__title">{group.title}</h3>
    <p class="skill-card__description">{group.description}</p>

    <ul class="skill-card__chips" aria-label={`Tecnologías de ${group.title}`}>
      {group.items.map((item, itemIndex) => (
        <li class="skill-chip reveal" style={`--delay: ${index * 90 + 120 + itemIndex * 24}ms`}>
          {item}
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .skill-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background:
      linear-gradient(145deg, rgba(var(--color-accent-primary-rgb), 0.04), transparent 42%),
      color-mix(in srgb, var(--color-card) 82%, transparent);
    padding: clamp(1rem, 2vw, 1.35rem);
    backdrop-filter: blur(18px);
    transition:
      border-color var(--transition-normal),
      box-shadow var(--transition-normal),
      transform var(--transition-normal);
  }

  .skill-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(var(--color-accent-primary-rgb), 0.08), transparent 38%);
    opacity: 0.14;
    transform: translate3d(-1%, -1%, 0);
    animation: skill-card-aura 8s ease-in-out infinite alternate;
    transition: opacity var(--transition-normal);
  }

  .skill-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
    transform: translateY(-6px);
  }

  .skill-card:hover::after {
    opacity: 0.34;
  }

  .skill-card__index {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: 1.2;
  }

  .skill-card__content {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .skill-card__title {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .skill-card__description {
    margin: 0.6rem 0 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .skill-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    list-style: none;
  }

  .skill-chip {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: rgba(var(--color-accent-primary-rgb), 0.045);
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.46rem 0.62rem;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .skill-chip:hover {
    border-color: var(--color-border-hover);
    background: rgba(var(--color-lilac), 0.08);
    color: var(--color-lilac-text);
    transform: translateY(-2px);
  }

  @keyframes skill-card-aura {
    0% {
      transform: translate3d(-1%, -1%, 0);
    }

    100% {
      transform: translate3d(1%, 1%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card,
    .skill-card::after,
    .skill-chip {
      transition: none;
      animation: none;
    }

    .skill-card:hover,
    .skill-chip:hover {
      transform: none;
    }
  }
</style>
