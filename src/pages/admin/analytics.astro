---
import 'leaflet/dist/leaflet.css';
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Analytics privado</title>
  </head>
  <body class="admin-analytics-page">
    <main class="analytics-shell">
      <header class="analytics-header">
        <div>
          <p class="eyebrow">Panel privado</p>
          <h1>Analytics</h1>
        </div>
        <p class="header-copy">Resumen visual de las ultimas 500 visitas registradas.</p>
      </header>

      <section class="login-panel" data-login-panel>
        <form
          class="login-form"
          method="post"
          action="/admin/analytics"
          autocomplete="on"
          data-login-form
        >
          <input
            type="text"
            name="username"
            value="admin"
            autocomplete="username"
            class="sr-only"
            tabindex="-1"
            aria-hidden="true"
          />
          <label for="admin-password">Contrasena</label>
          <div class="login-row">
            <input
              id="admin-password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="ADMIN_PASSWORD"
              required
              data-password-input
            />
            <button type="submit" data-login-button>Entrar</button>
          </div>
          <p class="form-message" role="status" data-login-message></p>
        </form>
      </section>

      <section class="dashboard" hidden data-dashboard>
        <div class="stats-grid">
          <article class="metric-card">
            <span>Visitas totales</span>
            <strong data-total-visits>0</strong>
          </article>
          <article class="metric-card">
            <span>Visitantes unicos</span>
            <strong data-unique-visitors>0</strong>
          </article>
        </div>

        <section class="map-panel">
          <div class="panel-heading map-heading">
            <div>
              <p class="section-kicker">Distribucion geografica</p>
              <h2>Mapa de visitas</h2>
            </div>
            <span class="map-chip" data-map-count>0 ubicaciones</span>
          </div>

          <div class="leaflet-map-shell">
            <div class="analytics-map" id="analytics-map" data-analytics-map></div>
          </div>

          <p class="map-note" data-map-note>
            Las ciudades se ubican con coordenadas reales cuando estan disponibles; si no, se usa el centro del pais.
          </p>
        </section>

        <div class="summary-grid">
          <section class="summary-panel">
            <div class="panel-heading">
              <h2>Paises</h2>
            </div>
            <div class="rank-list" data-list="countries"></div>
          </section>

          <section class="summary-panel">
            <div class="panel-heading">
              <h2>Paginas</h2>
            </div>
            <div class="rank-list" data-list="pages"></div>
          </section>

          <section class="summary-panel">
            <div class="panel-heading">
              <h2>Fuentes</h2>
            </div>
            <div class="rank-list" data-list="referrers"></div>
          </section>

          <section class="summary-panel">
            <div class="panel-heading">
              <h2>Dispositivos</h2>
            </div>
            <div class="rank-list" data-list="devices"></div>
          </section>

          <section class="summary-panel">
            <div class="panel-heading">
              <h2>Navegadores</h2>
            </div>
            <div class="rank-list" data-list="browsers"></div>
          </section>
        </div>

        <section class="visits-panel">
          <div class="panel-heading">
            <h2>Ultimas visitas</h2>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Pagina</th>
                  <th>Pais</th>
                  <th>Ciudad</th>
                  <th>Fuente</th>
                  <th>Dispositivo</th>
                  <th>Navegador</th>
                </tr>
              </thead>
              <tbody data-recent-visits></tbody>
            </table>
          </div>
        </section>
      </section>
    </main>

    <script>
      import '../../scripts/adminAnalytics.js';
    </script>
  </body>
</html>

<style>
  .admin-analytics-page {
    min-height: 100vh;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .analytics-shell {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .analytics-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 30rem);
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.35rem;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .analytics-header h1 {
    font-size: clamp(2.4rem, 7vw, 4.75rem);
  }

  .header-copy {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .login-panel,
  .summary-panel,
  .visits-panel,
  .metric-card,
  .map-panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018)),
      color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow: var(--shadow-card);
  }

  .login-panel {
    max-width: 560px;
    padding: 1.25rem;
  }

  .login-form label {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .login-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
  }

  input,
  button {
    min-height: 3rem;
    border-radius: var(--radius-md);
    font: inherit;
  }

  input {
    width: 100%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-primary);
    padding: 0 0.9rem;
  }

  button {
    border: 1px solid var(--color-accent-primary);
    background: var(--color-accent-primary);
    color: var(--color-bg);
    padding: 0 1.2rem;
    cursor: pointer;
    font-weight: 700;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .form-message {
    min-height: 1.5rem;
    margin: 0.75rem 0 0;
    color: var(--color-text-secondary);
  }

  .dashboard {
    display: grid;
    gap: 1rem;
  }

  .dashboard[hidden],
  .login-panel[hidden] {
    display: none;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .metric-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .metric-card span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .metric-card strong {
    color: var(--color-text-primary);
    font-size: clamp(2.25rem, 5vw, 3.35rem);
    line-height: 1;
  }

  .map-panel,
  .summary-panel,
  .visits-panel {
    padding: clamp(1rem, 2vw, 1.35rem);
  }

  .panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.95rem;
  }

  .panel-heading h2 {
    font-size: var(--text-xl);
  }

  .map-heading {
    align-items: start;
  }

  .map-chip {
    flex: 0 0 auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    padding: 0.35rem 0.7rem;
  }

  .leaflet-map-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.025);
  }

  .analytics-map {
    width: 100%;
    height: clamp(320px, 48vw, 560px);
    background: transparent;
  }

  .analytics-map .leaflet-control-attribution {
    background: rgba(0, 0, 0, 0.55);
    color: rgba(255, 255, 255, 0.65);
    font-size: 10px;
  }

  .analytics-map .leaflet-control-attribution a {
    color: rgba(255, 255, 255, 0.8);
  }

  .analytics-map .leaflet-control-zoom {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .analytics-map .leaflet-control-zoom a {
    border: 0;
    background: rgba(15, 15, 18, 0.92);
    color: var(--color-text-primary);
  }

  .analytics-map .leaflet-tile-pane {
    filter: saturate(0.75) contrast(1.05) brightness(0.82);
  }

  .analytics-map .analytics-map-tooltip {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface-elevated) 92%, #000000);
    box-shadow: var(--shadow-lg);
    color: var(--color-text-primary);
    padding: 0.7rem 0.8rem;
  }

  .analytics-map .analytics-map-tooltip::before {
    border-top-color: color-mix(in srgb, var(--color-surface-elevated) 92%, #000000);
  }

  .map-tooltip-content {
    display: grid;
    gap: 0.18rem;
  }

  .map-tooltip-content strong,
  .map-tooltip-content span,
  .map-tooltip-content em {
    display: block;
  }

  .map-tooltip-content span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .map-tooltip-content em {
    color: var(--color-lilac-text);
    font-style: normal;
    font-weight: 700;
  }

  .map-note {
    margin: 0.75rem 0 0;
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .summary-panel {
    display: flex;
    min-height: 240px;
    flex-direction: column;
  }

  :global(.rank-list) {
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  :global(.rank-row) {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    gap: 0.65rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.025);
    padding: 0.75rem;
  }

  :global(.rank-content) {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(3rem, auto);
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  :global(.rank-label) {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.rank-count) {
    flex: 0 0 auto;
    min-width: 3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    line-height: 1;
    padding: 0.35rem 0.6rem;
    text-align: center;
  }

  :global(.rank-track) {
    position: relative;
    z-index: 1;
    height: 0.28rem;
    overflow: hidden;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
  }

  :global(.rank-bar) {
    display: block;
    width: var(--bar-width);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(var(--color-lilac)), rgba(255, 255, 255, 0.72));
  }

  :global(.empty-state) {
    margin: 0;
    color: var(--color-text-subtle);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.8rem 0.65rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
  }

  td {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  tbody tr:hover td {
    background: rgba(255, 255, 255, 0.025);
  }

  @media (max-width: 980px) {
    .summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .analytics-header,
    .stats-grid,
    .summary-grid {
      grid-template-columns: 1fr;
    }

    .analytics-map {
      height: 360px;
    }
  }

  @media (max-width: 560px) {
    .login-row {
      grid-template-columns: 1fr;
    }

    .panel-heading {
      align-items: start;
      flex-direction: column;
    }

    .map-chip {
      align-self: flex-start;
    }
  }
</style>
