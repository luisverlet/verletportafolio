<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-theme-state="dark"
  aria-label="Cambiar a modo claro"
  aria-pressed="true"
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__sun"></span>
    <span class="theme-toggle__moon"></span>
    <span class="theme-toggle__thumb"></span>
  </span>
</button>

<style>
  .theme-toggle {
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 34px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-card);
    box-shadow: var(--shadow-soft);
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 0;
    backdrop-filter: blur(14px);
    transition:
      background-color var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal),
      transform var(--transition-normal);
  }

  .theme-toggle__track {
    position: relative;
    display: block;
    width: 30px;
    height: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: rgba(var(--color-accent-primary-rgb), 0.08);
    transition:
      background-color var(--transition-normal),
      border-color var(--transition-normal);
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--color-accent-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-accent-primary-rgb), 0.1);
    transform: translateX(0);
    transition:
      box-shadow var(--transition-normal),
      transform var(--transition-normal);
  }

  .theme-toggle__sun,
  .theme-toggle__moon {
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    transform: translateY(-50%);
  }

  .theme-toggle__sun {
    right: 4px;
    background: currentColor;
    opacity: 0.38;
  }

  .theme-toggle__moon {
    left: 4px;
    border: 1px solid currentColor;
    opacity: 0.38;
  }

  .theme-toggle[data-theme-state='light'] .theme-toggle__thumb {
    transform: translateX(12px);
  }

  .theme-toggle:hover .theme-toggle__track {
    border-color: var(--color-border-hover);
    background: rgba(var(--color-accent-primary-rgb), 0.13);
  }

  .theme-toggle:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .theme-toggle:hover .theme-toggle__thumb {
    box-shadow: 0 0 0 5px rgba(var(--color-accent-primary-rgb), 0.12);
  }

  @media (max-width: 640px) {
    .theme-toggle {
      flex: 0 0 auto;
      width: 42px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle * {
      transition: none;
    }

    .theme-toggle:hover {
      transform: none;
    }
  }
</style>
