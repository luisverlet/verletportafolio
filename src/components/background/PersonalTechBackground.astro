  name: string;
  icon: string;
  x: string;
  y: string;
  size: string;
  depth: Depth;
  tone: Tone;
  kind: Kind;
  duration: string;
  delay: string;
  drift: string;
  rotate: string;
  mobile?: 'keep' | 'hide';
  egg?: boolean;
}

const iconUrl = (icon: string) => `https://api.iconify.design/${icon}.svg`;

