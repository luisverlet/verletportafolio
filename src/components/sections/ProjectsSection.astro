---
import { projects } from '../../data/projects';
import SectionTitle from '../common/SectionTitle.astro';
import ProjectCard from '../ui/ProjectCard.astro';

const featuredProjects = projects.filter((project) => project.featured);
---

<section id="proyectos" class="projects-section">
  <div class="container projects-container">
    <SectionTitle
      title="Proyectos con impacto"
      subtitle="Casos seleccionados"
      align="left"
    />

    <div class="projects-grid">
      {featuredProjects.map((project, index) => (
        <div class="project-item reveal" style={`--delay: ${index * 120}ms`}>
          <ProjectCard project={project} index={index} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vh, 7rem) 0;
    border-top: 1px solid var(--border-color);
    background:
      radial-gradient(circle at 18% 6%, rgba(var(--color-lilac), 0.055), transparent 24rem),
      radial-gradient(circle at 88% 58%, rgba(var(--color-lilac), 0.035), transparent 22rem);
  }

  .projects-section::before {
    content: none;
  }

  .projects-section::after {
    content: none;
  }

  .projects-container {
    position: relative;
    z-index: 1;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    align-items: stretch;
    max-width: 1050px;
    margin-top: var(--space-12);
    margin-inline: auto;
  }

  .project-item {
    display: flex;
    min-width: 0;
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
  }

</style>
