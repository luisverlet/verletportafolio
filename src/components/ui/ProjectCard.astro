---
import type { Project } from '../../data/projects';
import jookerpLaptop from '../../assets/images/JookERP_LAPTOPTHOME.png';
import menteSeguraLaptop from '../../assets/images/MenteSegura_LAPTOPTHOME.png';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const visualMap = {
  'mentesegura-mobile': {
    image: menteSeguraLaptop.src,
    tone: 'coral'
  },
  'jookerp-demand': {
    image: jookerpLaptop.src,
    tone: 'blue'
  }
} as const;

const visual = visualMap[project.id as keyof typeof visualMap];
const imageSrc = visual?.image ?? project.image;
const tone = visual?.tone ?? 'neutral';
---

<article class={`project-card project-card--${tone}`}>
  <div class="project-visual">
    <img
      src={imageSrc}
      alt={`Vista de laptop del proyecto ${project.title}`}
      class="project-img"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="project-content">
    <h3 class="project-title">{project.title}</h3>

    <dl class="project-meta">
      <div>
        <dt>Rol</dt>
        <dd>Full Stack Developer</dd>
      </div>

      <div>
        <dt>Tecnolog&iacute;as</dt>
        <dd>{project.tags.join(', ')}</dd>
      </div>
    </dl>

    <p class="project-description">{project.description}</p>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: clamp(1.35rem, 2.4vw, 1.8rem);
    height: 100%;
    color: var(--color-white);
  }

  .project-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(270px, 34vw, 425px);
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle at 28% 16%, rgba(255, 255, 255, 0.24), transparent 30%),
      linear-gradient(145deg, var(--project-card-start), var(--project-card-end));
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.26);
  }

  .project-visual::before {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: inherit;
    pointer-events: none;
  }

  .project-card--coral {
    --project-card-start: #ff7a2d;
    --project-card-end: #ff3030;
  }

  .project-card--blue {
    --project-card-start: #3b91ff;
    --project-card-end: #0057bd;
  }

  .project-card--neutral {
    --project-card-start: #353136;
    --project-card-end: #171217;
  }

  .project-img {
    position: relative;
    z-index: 1;
    width: min(82%, 330px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, 0.24));
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-img {
    transform: translateY(-6px);
  }

  .project-content {
    display: grid;
    gap: clamp(0.9rem, 1.6vw, 1.2rem);
    text-align: center;
  }

  .project-title {
    margin: 0;
    color: var(--color-white);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .project-meta {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .project-meta div {
    display: grid;
    gap: 0.08rem;
  }

  .project-meta dt {
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(1.05rem, 1.9vw, 1.35rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .project-meta dd {
    margin: 0 auto;
    max-width: 310px;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.8vw, 1.22rem);
    line-height: 1.22;
  }

  .project-description {
    max-width: 360px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(0.9rem, 1.4vw, 0.98rem);
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .project-visual {
      min-height: clamp(250px, 74vw, 390px);
    }

    .project-img {
      width: min(82%, 340px);
    }
  }

  @media (max-width: 460px) {
    .project-visual {
      min-height: 245px;
    }

    .project-img {
      width: 88%;
    }
  }
</style>
