---
import { DEFAULT_LANGUAGE, getTranslations } from '../../i18n';
import SkillCard from '../ui/SkillCard.astro';

const copy = getTranslations(DEFAULT_LANGUAGE).skills;
---

<section id="skills" class="skills-section py-20" aria-labelledby="skills-title">
  <div class="container skills-container">
    <div class="skills-header">
      <span class="skills-eyebrow reveal" data-i18n="skills.eyebrow">{copy.eyebrow}</span>
      <h2 id="skills-title" class="skills-title reveal" style="--delay: 80ms" data-i18n="skills.title">{copy.title}</h2>
      <p class="skills-subtitle reveal" style="--delay: 140ms" data-i18n="skills.description">{copy.description}</p>
    </div>

    <div class="skills-marquee reveal" style="--delay: 180ms" aria-label={copy.marqueeAriaLabel} data-i18n-aria-label="skills.marqueeAriaLabel">
      <div class="skills-marquee__track">
        {[...copy.marquee, ...copy.marquee].map((skill, index) => (
          <span class="skills-marquee__item" data-i18n={`skills.marquee.${index % copy.marquee.length}`}>{skill}</span>
        ))}
      </div>
    </div>

    <div class="skills-grid">
      {copy.groups.map((group, index) => (
        <SkillCard group={group} index={index} />
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 15% 0%, rgba(var(--color-lilac), 0.055), transparent 24rem),
      radial-gradient(circle at 90% 35%, rgba(var(--color-lilac), 0.04), transparent 22rem);
  }

  .skills-section::after {
    content: '';
    position: absolute;
    left: var(--space-6);
    right: var(--space-6);
    bottom: 0;
    height: 1px;
    background: var(--color-border);
  }

  .skills-container {
    position: relative;
    z-index: 1;
  }

  .skills-header {
    max-width: 720px;
  }

  .skills-eyebrow {
    display: inline-flex;
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .skills-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    font-weight: 800;
    line-height: 0.96;
    text-wrap: balance;
  }

  .skills-subtitle {
    max-width: 560px;
    margin: var(--space-5) 0 0;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .skills-marquee {
    overflow: hidden;
    margin-top: var(--space-10);
    border-block: 1px solid var(--color-border);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .skills-marquee__track {
    display: flex;
    width: max-content;
    gap: var(--space-4);
    padding-block: 0.9rem;
    animation: skills-marquee 28s linear infinite;
  }

  .skills-marquee__item {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: rgba(var(--color-accent-primary-rgb), 0.04);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.5rem 0.75rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  @keyframes skills-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 980px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .skills-title {
      font-size: 3rem;
    }

    .skills-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-marquee__track {
      animation: none;
    }
  }
</style>
